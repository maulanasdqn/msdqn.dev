---
import NavigationBar from '../components/ui/navigation-bar.astro';
import FooterSection from '../components/ui/footer-section.astro';
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>About - Maulana Sodiqin</title>
		<meta name="description" content="Learn about Maulana Sodiqin's 5+ years of experience as a Frontend-focused Software Engineer specializing in ReactJS, TypeScript, and modern web technologies.">
	</head>
	<body class="bg-rose-pine-base text-rose-pine-text">
		<NavigationBar currentPath="/about" />
		
		<main class="pt-20">
			<!-- Hero Section -->
			<section class="py-20 px-6 bg-gradient-to-br from-rose-pine-base via-rose-pine-surface to-rose-pine-overlay">
				<div class="max-w-4xl mx-auto text-center">
					<h1 class="text-4xl md:text-5xl font-bold mb-6 text-rose-pine-text">About Me</h1>
					<p class="text-xl text-rose-pine-subtle max-w-3xl mx-auto leading-relaxed">
						Frontend-focused Software Engineer with 5+ years of experience building scalable and maintainable web applications using ReactJS, TypeScript, and TailwindCSS.
					</p>
				</div>
			</section>

			<!-- Summary Section -->
			<section class="py-16 px-6 bg-rose-pine-surface">
				<div class="max-w-4xl mx-auto">
					<h2 class="text-3xl font-bold mb-8 text-rose-pine-text text-center">Professional Summary</h2>
					<div class="bg-rose-pine-overlay/50 backdrop-blur-sm p-8 rounded-xl border border-rose-pine-highlight-med">
						<p class="text-rose-pine-subtle text-lg leading-relaxed mb-6">
							I am proficient in modular UI architecture, design systems, test-driven development, and modern state management with React Query and Jotai. I have extensive experience working with micro frontend structures and NX monorepos to support large-scale applications.
						</p>
						<p class="text-rose-pine-subtle text-lg leading-relaxed">
							Currently expanding my full-stack skills with <span class="text-rose-pine-iris font-semibold">Rust and Axum</span> to gain deeper backend architecture understanding, while maintaining my expertise in modern frontend technologies.
						</p>
					</div>
				</div>
			</section>

			<!-- Skills Section -->
			<section class="py-16 px-6 bg-rose-pine-base">
				<div class="max-w-6xl mx-auto">
					<h2 class="text-3xl font-bold mb-12 text-rose-pine-text text-center">Technical Skills</h2>
					<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
						<!-- Frontend Development -->
						<div class="bg-rose-pine-surface/50 backdrop-blur-sm p-6 rounded-xl border border-rose-pine-highlight-med">
							<div class="w-12 h-12 bg-rose-pine-iris/20 rounded-lg flex items-center justify-center mb-4">
								<svg class="w-6 h-6 text-rose-pine-iris" fill="currentColor" viewBox="0 0 24 24">
									<path d="M12 0l3.09 6.26L22 7.27l-5 4.87 1.18 6.88L12 15.77l-6.18 3.25L7 12.14 2 7.27l6.91-1.01L12 0z"/>
								</svg>
							</div>
							<h3 class="text-xl font-semibold mb-3 text-rose-pine-text">Frontend Development</h3>
							<ul class="text-rose-pine-subtle space-y-1 text-sm">
								<li>• ReactJS, NextJS, TypeScript</li>
								<li>• JavaScript (ES6+)</li>
								<li>• TailwindCSS, Shadcn, Ant Design</li>
								<li>• HTML/CSS, Responsive Design</li>
							</ul>
						</div>

						<!-- State Management -->
						<div class="bg-rose-pine-surface/50 backdrop-blur-sm p-6 rounded-xl border border-rose-pine-highlight-med">
							<div class="w-12 h-12 bg-rose-pine-love/20 rounded-lg flex items-center justify-center mb-4">
								<svg class="w-6 h-6 text-rose-pine-love" fill="currentColor" viewBox="0 0 24 24">
									<path d="M12 0l3.09 6.26L22 7.27l-5 4.87 1.18 6.88L12 15.77l-6.18 3.25L7 12.14 2 7.27l6.91-1.01L12 0z"/>
								</svg>
							</div>
							<h3 class="text-xl font-semibold mb-3 text-rose-pine-text">State Management</h3>
							<ul class="text-rose-pine-subtle space-y-1 text-sm">
								<li>• Tanstack React Query</li>
								<li>• Jotai, Zustand, Recoil</li>
								<li>• Redux</li>
							</ul>
						</div>

						<!-- Testing & Quality -->
						<div class="bg-rose-pine-surface/50 backdrop-blur-sm p-6 rounded-xl border border-rose-pine-highlight-med">
							<div class="w-12 h-12 bg-rose-pine-foam/20 rounded-lg flex items-center justify-center mb-4">
								<svg class="w-6 h-6 text-rose-pine-foam" fill="currentColor" viewBox="0 0 24 24">
									<path d="M12 0l3.09 6.26L22 7.27l-5 4.87 1.18 6.88L12 15.77l-6.18 3.25L7 12.14 2 7.27l6.91-1.01L12 0z"/>
								</svg>
							</div>
							<h3 class="text-xl font-semibold mb-3 text-rose-pine-text">Testing & Quality</h3>
							<ul class="text-rose-pine-subtle space-y-1 text-sm">
								<li>• React Testing Library</li>
								<li>• Vitest, Jest, MSW</li>
								<li>• Test-Driven Development</li>
							</ul>
						</div>

						<!-- Architecture -->
						<div class="bg-rose-pine-surface/50 backdrop-blur-sm p-6 rounded-xl border border-rose-pine-highlight-med">
							<div class="w-12 h-12 bg-rose-pine-pine/20 rounded-lg flex items-center justify-center mb-4">
								<svg class="w-6 h-6 text-rose-pine-pine" fill="currentColor" viewBox="0 0 24 24">
									<path d="M12 0l3.09 6.26L22 7.27l-5 4.87 1.18 6.88L12 15.77l-6.18 3.25L7 12.14 2 7.27l6.91-1.01L12 0z"/>
								</svg>
							</div>
							<h3 class="text-xl font-semibold mb-3 text-rose-pine-text">Frontend Architecture</h3>
							<ul class="text-rose-pine-subtle space-y-1 text-sm">
								<li>• NX Monorepo</li>
								<li>• Module Federation</li>
								<li>• Micro Frontend</li>
							</ul>
						</div>

						<!-- Backend & Database -->
						<div class="bg-rose-pine-surface/50 backdrop-blur-sm p-6 rounded-xl border border-rose-pine-highlight-med">
							<div class="w-12 h-12 bg-rose-pine-gold/20 rounded-lg flex items-center justify-center mb-4">
								<svg class="w-6 h-6 text-rose-pine-gold" fill="currentColor" viewBox="0 0 24 24">
									<path d="M12 0l3.09 6.26L22 7.27l-5 4.87 1.18 6.88L12 15.77l-6.18 3.25L7 12.14 2 7.27l6.91-1.01L12 0z"/>
								</svg>
							</div>
							<h3 class="text-xl font-semibold mb-3 text-rose-pine-text">Backend & Database</h3>
							<ul class="text-rose-pine-subtle space-y-1 text-sm">
								<li>• Rust, Axum, SurrealDB</li>
								<li>• PostgreSQL</li>
								<li>• HonoJS, NestJS, ExpressJS</li>
								<li>• Drizzle, Prisma, TypeORM</li>
							</ul>
						</div>

						<!-- UI Tooling & Design -->
						<div class="bg-rose-pine-surface/50 backdrop-blur-sm p-6 rounded-xl border border-rose-pine-highlight-med">
							<div class="w-12 h-12 bg-rose-pine-rose/20 rounded-lg flex items-center justify-center mb-4">
								<svg class="w-6 h-6 text-rose-pine-rose" fill="currentColor" viewBox="0 0 24 24">
									<path d="M12 0l3.09 6.26L22 7.27l-5 4.87 1.18 6.88L12 15.77l-6.18 3.25L7 12.14 2 7.27l6.91-1.01L12 0z"/>
								</svg>
							</div>
							<h3 class="text-xl font-semibold mb-3 text-rose-pine-text">UI Tooling & Design</h3>
							<ul class="text-rose-pine-subtle space-y-1 text-sm">
								<li>• Storybook, Design Systems</li>
								<li>• Component-Driven Development</li>
								<li>• Performance Optimization</li>
								<li>• Accessibility, Cross-Browser</li>
							</ul>
						</div>
					</div>
				</div>
			</section>

			<!-- Location & Contact -->
			<section class="py-16 px-6 bg-rose-pine-surface">
				<div class="max-w-4xl mx-auto text-center">
					<h2 class="text-3xl font-bold mb-8 text-rose-pine-text">Get In Touch</h2>
					<div class="bg-rose-pine-overlay/50 backdrop-blur-sm p-8 rounded-xl border border-rose-pine-highlight-med">
						<p class="text-rose-pine-subtle text-lg mb-6">
							📍 Based in <span class="text-rose-pine-iris font-semibold">Malang, East Java, Indonesia</span>
						</p>
						<p class="text-rose-pine-subtle text-lg mb-8">
							I'm always interested in discussing new opportunities, challenging projects, and collaborations with innovative teams.
						</p>
						<div class="flex flex-col sm:flex-row gap-4 justify-center">
							<a href="mailto:maulanasdqn@gmail.com" class="bg-rose-pine-iris hover:bg-rose-pine-iris/80 text-rose-pine-base px-8 py-3 rounded-full font-medium transition-all duration-300 transform hover:scale-105">
								Email Me
							</a>
							<a href="/contact" class="bg-rose-pine-overlay hover:bg-rose-pine-highlight-med text-rose-pine-text px-8 py-3 rounded-full font-medium border border-rose-pine-highlight-med transition-all duration-300 transform hover:scale-105">
								Contact Form
							</a>
						</div>
					</div>
				</div>
			</section>
		</main>
		
		<FooterSection />
	</body>
</html> 