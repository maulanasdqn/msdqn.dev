---
import FooterSection from '@/components/ui/footer-section.astro';
import NavigationBar from '@/components/ui/navigation-bar.astro';
import SectionHeading from '@/components/ui/section-heading.astro';

const siteUrl = 'https://msdqn.dev';

const lookingFor = [
  {
    title: 'Full-time roles',
    detail: 'Senior software engineering in Rust and TypeScript',
  },
  {
    title: 'Contract work',
    detail: 'Full-stack client platforms, delivered end to end',
  },
  {
    title: 'Web scraping & automation',
    detail: 'Scraping engines, anti-bot unblocking, Chromium/CDP',
  },
  {
    title: 'Remote or relocation',
    detail: 'Based in Bandung, Indonesia, and open to both',
  },
];

const expertise = [
  { title: 'Languages', detail: 'Rust, TypeScript, JavaScript, SQL, PHP' },
  {
    title: 'Backend',
    detail: 'Axum, Tokio, tonic (gRPC), sqlx, Hono, oRPC, Laravel',
  },
  {
    title: 'Frontend',
    detail: 'React, TanStack Start/Router/Query, Next.js, Vue, TailwindCSS',
  },
  {
    title: 'Data & Infra',
    detail: 'PostgreSQL, Redis, RabbitMQ, BigQuery, Docker, Kubernetes',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#0a0a0a" />

    <title>Hire me — Maulana Sodiqin</title>

    <meta
      name="description"
      content="Hire Maulana Sodiqin, senior software engineer with 7 years of experience building production web platforms in Rust and TypeScript. Open to full-time and contract work, remote or relocation."
    />

    <meta
      name="keywords"
      content="hire maulana sodiqin, react developer for hire, fullstack developer hire, typescript developer available, rust developer freelance, senior frontend developer job, software engineer hire, remote developer indonesia, fullstack developer available, react specialist hire, javascript developer hire"
    />

    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={`${siteUrl}/hire-me`} />

    <meta property="og:title" content="Hire me — Maulana Sodiqin" />
    <meta
      property="og:description"
      content="Senior software engineer with 7 years of experience in Rust and TypeScript. Open to remote and relocation."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${siteUrl}/hire-me`} />
    <meta property="og:image" content={`${siteUrl}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${siteUrl}/og-image.png`} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'ProfilePage',
        name: 'Hire Maulana Sodiqin - Senior Software Engineer',
        url: `${siteUrl}/hire-me`,
        mainEntity: {
          '@type': 'Person',
          name: 'Maulana Sodiqin',
          url: siteUrl,
          image: `${siteUrl}/og-image.png`,
          jobTitle: 'Senior Software Engineer',
          description:
            'Senior software engineer with 7 years of experience building production web platforms in Rust and TypeScript. Sole engineer behind a rebuilt web scraping engine (400 jobs/s sustained, anti-bot unblocking), and delivers full-stack client platforms end to end.',
          sameAs: [
            'https://www.linkedin.com/in/maulana-sodiqin/',
            'https://github.com/maulanasdqn',
          ],
          knowsAbout: [
            'React',
            'TypeScript',
            'JavaScript',
            'Rust',
            'Next.js',
            'Node.js',
            'Frontend Development',
            'Backend Development',
            'Full Stack Development',
          ],
          address: {
            '@type': 'PostalAddress',
            addressLocality: 'Bandung',
            addressRegion: 'West Java',
            addressCountry: 'Indonesia',
          },
        },
      })}
    />
  </head>

  <body class="bg-mono-bg text-mono-text antialiased">
    <NavigationBar />

    <main>
      <section class="max-w-5xl mx-auto px-6 sm:px-8 pt-36 sm:pt-44 pb-16">
        <p
          class="text-xs font-medium uppercase tracking-[0.14em] text-mono-muted mb-10 flex items-center gap-3"
        >
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-mono-text"
          ></span>
          Available for new work
        </p>
        <h1
          class="font-medium text-5xl sm:text-6xl lg:text-7xl leading-[1.05] tracking-tight text-mono-text max-w-4xl"
        >
          Let&rsquo;s bring your project to life.
        </h1>
        <p class="mt-10 max-w-xl text-lg leading-relaxed text-mono-subtle">
          Senior software engineer with 7 years of experience building
          production web platforms in Rust and TypeScript. I rebuilt a web
          scraping engine as its sole engineer and deliver full-stack client
          platforms end to end.
        </p>
        <div class="mt-12 flex flex-wrap items-center gap-x-8 gap-y-4 text-sm">
          <a
            href="mailto:maulanasdqn@gmail.com?subject=Hiring Inquiry - Senior Software Engineer"
            class="inline-flex items-center gap-2 bg-mono-text text-mono-bg px-5 py-3 hover:bg-mono-subtle transition-colors"
          >
            Email me <span aria-hidden="true">&rarr;</span>
          </a>
          <a
            href="/resume.pdf"
            download="Maulana_Sodiqin_Resume.pdf"
            class="text-mono-text underline decoration-mono-line-strong underline-offset-[6px] hover:decoration-mono-text transition-colors"
          >
            Download r&eacute;sum&eacute;
          </a>
          <a
            href="https://www.linkedin.com/in/maulana-sodiqin/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-mono-subtle hover:text-mono-text transition-colors"
          >
            LinkedIn <span aria-hidden="true">&nearr;</span>
          </a>
        </div>
      </section>

      <section
        class="max-w-5xl mx-auto px-6 sm:px-8 py-16 sm:py-20"
        aria-labelledby="looking-heading"
      >
        <SectionHeading
          number="01"
          title="What I'm looking for"
          id="looking-heading"
        />
        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-16">
          {
            lookingFor.map(item => (
              <div class="py-6 border-b border-mono-line">
                <dt class="font-medium text-2xl tracking-tight text-mono-text">
                  {item.title}
                </dt>
                <dd class="mt-2 text-mono-subtle">{item.detail}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section
        class="max-w-5xl mx-auto px-6 sm:px-8 py-16 sm:py-20"
        aria-labelledby="expertise-heading"
      >
        <SectionHeading number="02" title="Expertise" id="expertise-heading" />
        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-16">
          {
            expertise.map(item => (
              <div class="py-6 border-b border-mono-line">
                <dt class="font-medium text-2xl tracking-tight text-mono-text">
                  {item.title}
                </dt>
                <dd class="mt-2 text-mono-subtle">{item.detail}</dd>
              </div>
            ))
          }
        </dl>
      </section>
    </main>

    <FooterSection />
  </body>
</html>
