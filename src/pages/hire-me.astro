---
import AnalyticsPartytown from '@/components/ui/analytics-partytown.astro';
import FooterSection from '@/components/ui/footer-section.astro';
import NavigationBar from '@/components/ui/navigation-bar.astro';

const siteUrl = 'https://msdqn.dev';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <AnalyticsPartytown />

    <title>
      Hire Maulana Sodiqin - Available for Full-time & Freelance | Senior React
      Developer
    </title>

    <meta
      name="description"
      content="Hire Maulana Sodiqin, experienced Senior Fullstack Developer. Available for full-time positions, freelance projects, and consulting. 5+ years React, TypeScript, Rust expertise. Remote work available."
    />

    <meta
      name="keywords"
      content="hire maulana sodiqin, react developer for hire, fullstack developer hire, typescript developer available, rust developer freelance, senior frontend developer job, software engineer hire, remote developer indonesia, fullstack developer available, react specialist hire, javascript developer hire"
    />

    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={`${siteUrl}/hire-me`} />

    <meta
      property="og:title"
      content="Hire Maulana Sodiqin - Available for Full-time & Freelance"
    />
    <meta
      property="og:description"
      content="Experienced Senior Fullstack Developer available for hire. Remote work available."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${siteUrl}/hire-me`} />
    <meta property="og:image" content={`${siteUrl}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${siteUrl}/og-image.png`} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'ProfilePage',
        name: 'Hire Maulana Sodiqin - Senior Fullstack Developer',
        url: `${siteUrl}/hire-me`,
        mainEntity: {
          '@type': 'Person',
          name: 'Maulana Sodiqin',
          url: siteUrl,
          image: `${siteUrl}/og-image.png`,
          jobTitle: 'Senior Software Engineer',
          description:
            'Experienced Senior Fullstack Developer with 5+ years of expertise in React, TypeScript, and Rust. Available for full-time positions, freelance projects, and consulting work.',
          sameAs: [
            'https://www.linkedin.com/in/maulana-sodiqin/',
            'https://github.com/maulanasdqn',
          ],
          knowsAbout: [
            'React',
            'TypeScript',
            'JavaScript',
            'Rust',
            'Next.js',
            'Node.js',
            'Frontend Development',
            'Backend Development',
            'Full Stack Development',
          ],
          address: {
            '@type': 'PostalAddress',
            addressLocality: 'Bandung',
            addressRegion: 'West Java',
            addressCountry: 'Indonesia',
          },
        },
      })}
    />
  </head>

  <body class="bg-rose-pine-base text-rose-pine-text">
    <NavigationBar />

    <main class="pt-20">
      <section class="py-20 px-6 bg-rose-pine-base">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-16">
            <h1 class="text-5xl font-bold text-rose-pine-text mb-6">
              Ready to Hire Me?
            </h1>
            <p
              class="text-xl text-rose-pine-subtle max-w-3xl mx-auto leading-relaxed mb-8"
            >
              I'm currently <span class="text-rose-pine-foam font-semibold"
                >available</span
              > and actively seeking new opportunities. Let's discuss how I can help
              bring your projects to life.
            </p>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mb-16">
            <div
              class="bg-rose-pine-surface/50 p-8 rounded-2xl border border-rose-pine-highlight-med"
            >
              <h2 class="text-3xl font-bold text-rose-pine-text mb-6">
                🎯 What I'm Looking For
              </h2>
              <ul class="space-y-4 text-rose-pine-subtle">
                <li class="flex items-start">
                  <span class="text-rose-pine-foam mr-3">✓</span>
                  <div>
                    <strong class="text-rose-pine-text"
                      >Full-time Positions:</strong
                    >
                    <span class="block"
                      >Senior Frontend/Fullstack Developer roles</span
                    >
                  </div>
                </li>
                <li class="flex items-start">
                  <span class="text-rose-pine-foam mr-3">✓</span>
                  <div>
                    <strong class="text-rose-pine-text"
                      >Freelance Projects:</strong
                    >
                    <span class="block">Short-term to long-term contracts</span>
                  </div>
                </li>
                <li class="flex items-start">
                  <span class="text-rose-pine-foam mr-3">✓</span>
                  <div>
                    <strong class="text-rose-pine-text">Consulting:</strong>
                    <span class="block"
                      >Architecture reviews, code audits, mentoring</span
                    >
                  </div>
                </li>
                <li class="flex items-start">
                  <span class="text-rose-pine-foam mr-3">✓</span>
                  <div>
                    <strong class="text-rose-pine-text">Remote Work:</strong>
                    <span class="block"
                      >Open to worldwide remote opportunities</span
                    >
                  </div>
                </li>
              </ul>
            </div>

            <div
              class="bg-rose-pine-surface/50 p-8 rounded-2xl border border-rose-pine-highlight-med"
            >
              <h2 class="text-3xl font-bold text-rose-pine-text mb-6">
                💼 My Expertise
              </h2>
              <div class="space-y-4">
                <div>
                  <h3 class="text-lg font-semibold text-rose-pine-text mb-2">
                    Frontend Mastery
                  </h3>
                  <p class="text-rose-pine-subtle text-sm">
                    React, TypeScript, Next.js, TailwindCSS, Modern JS
                  </p>
                </div>
                <div>
                  <h3 class="text-lg font-semibold text-rose-pine-text mb-2">
                    Backend Skills
                  </h3>
                  <p class="text-rose-pine-subtle text-sm">
                    Rust, Node.js, PostgreSQL, API Design
                  </p>
                </div>
                <div>
                  <h3 class="text-lg font-semibold text-rose-pine-text mb-2">
                    Architecture
                  </h3>
                  <p class="text-rose-pine-subtle text-sm">
                    Micro-frontends, Design Systems, Performance
                  </p>
                </div>
                <div>
                  <h3 class="text-lg font-semibold text-rose-pine-text mb-2">
                    Experience
                  </h3>
                  <p class="text-rose-pine-subtle text-sm">
                    5+ years, served 1000+ users, 10+ projects
                  </p>
                </div>
              </div>
            </div>
          </div>

          <div
            class="text-center bg-rose-pine-surface/50 p-12 rounded-2xl border border-rose-pine-highlight-med"
          >
            <h2 class="text-3xl font-bold text-rose-pine-text mb-6">
              Let's Start a Conversation
            </h2>
            <p class="text-lg text-rose-pine-subtle mb-8 max-w-2xl mx-auto">
              Whether you're a startup looking to build from scratch or an
              enterprise needing to scale, I'm here to help. Let's discuss your
              project requirements.
            </p>

            <div
              class="flex flex-col sm:flex-row gap-4 justify-center items-center"
            >
              <a
                href="mailto:maulanasdqn@gmail.com?subject=Hiring Inquiry - Fullstack Developer Position"
                class="bg-rose-pine-love hover:bg-rose-pine-love/80 text-rose-pine-base px-8 py-4 rounded-xl font-semibold transition-all duration-300 transform hover:scale-105 inline-flex items-center gap-2"
              >
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                  ></path>
                </svg>
                Email Me
              </a>

              <a
                href="https://www.linkedin.com/in/maulana-sodiqin/"
                target="_blank"
                rel="noopener noreferrer"
                class="bg-rose-pine-iris hover:bg-rose-pine-iris/80 text-rose-pine-base px-8 py-4 rounded-xl font-semibold transition-all duration-300 transform hover:scale-105 inline-flex items-center gap-2"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path
                    d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                  ></path>
                </svg>
                LinkedIn
              </a>

              <a
                href="/resume.pdf"
                download="Maulana_Sodiqin_Resume.pdf"
                class="bg-rose-pine-foam hover:bg-rose-pine-foam/80 text-rose-pine-base px-8 py-4 rounded-xl font-semibold transition-all duration-300 transform hover:scale-105 inline-flex items-center gap-2"
              >
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                  ></path>
                </svg>
                Download Resume
              </a>
            </div>
          </div>

          <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
            <div class="bg-rose-pine-surface/30 p-6 rounded-xl">
              <div class="text-3xl font-bold text-rose-pine-iris mb-2">24h</div>
              <div class="text-rose-pine-subtle">Response Time</div>
            </div>
            <div class="bg-rose-pine-surface/30 p-6 rounded-xl">
              <div class="text-3xl font-bold text-rose-pine-foam mb-2">
                Remote
              </div>
              <div class="text-rose-pine-subtle">Work Available</div>
            </div>
            <div class="bg-rose-pine-surface/30 p-6 rounded-xl">
              <div class="text-3xl font-bold text-rose-pine-rose mb-2">5+</div>
              <div class="text-rose-pine-subtle">Years Experience</div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <FooterSection />
  </body>
</html>
