---
import ProjectCard from '@/components/ui/project-card.astro';
import { getSessionUser } from '@/libs/auth';
import { getDb, listRows } from '@/libs/d1';

const user = await getSessionUser(Astro.locals, Astro.cookies);
if (!user) {
  return Astro.redirect('/login');
}

let projects = [];
let error = null;
try {
  projects = await listRows(getDb(Astro.locals), 'projects');
} catch (e) {
  error = e;
}

const email = user.email;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Projects Management - CMS</title>
    <meta name="description" content="Manage portfolio projects" />
    <style>
      :root {
        --mono-bg: #0a0a0a;
        --mono-surface: #111111;
        --mono-raised: #262626;
        --mono-muted: #737373;
        --mono-subtle: #a3a3a3;
        --mono-text: #fafafa;
        --mono-accent: #fafafa;
      }
      body {
        background-color: var(--mono-bg);
        color: var(--mono-text);
        font-family:
          system-ui,
          -apple-system,
          sans-serif;
        margin: 0;
        padding: 0;
      }
      .nav-bg {
        background-color: var(--mono-surface);
        border-bottom: 1px solid var(--mono-raised);
      }
      .card-bg {
        background-color: var(--mono-surface);
        border: 1px solid var(--mono-raised);
      }
      .btn-primary {
        background-color: var(--mono-accent);
        color: var(--mono-bg);
        border: none;
        padding: 8px 16px;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.2s;
      }
      .btn-primary:hover {
        background-color: var(--mono-accent);
        color: var(--mono-bg);
      }
      .btn-edit {
        background-color: var(--mono-accent);
        color: var(--mono-bg);
        border: none;
        padding: 6px 12px;
        border-radius: 4px;
        cursor: pointer;
        transition: all 0.2s;
      }
      .btn-edit:hover {
        background-color: var(--mono-accent);
      }
      .btn-delete {
        background-color: var(--mono-accent);
        color: var(--mono-bg);
        border: none;
        padding: 6px 12px;
        border-radius: 4px;
        cursor: pointer;
        transition: all 0.2s;
      }
      .btn-delete:hover {
        background-color: #d4d4d4;
      }
      .btn-signout {
        background-color: var(--mono-accent);
        color: var(--mono-bg);
        border: none;
        padding: 8px 16px;
        border-radius: 6px;
        cursor: pointer;
      }
      .btn-signout:hover {
        background-color: #d4d4d4;
      }
      .text-muted {
        color: var(--mono-muted);
      }
      .text-subtle {
        color: var(--mono-subtle);
      }
      .nav-link {
        color: var(--mono-subtle);
        border-bottom: 2px solid transparent;
        text-decoration: none;
        padding: 8px 4px;
        transition: all 0.2s;
      }
      .nav-link:hover {
        color: var(--mono-text);
        border-bottom-color: var(--mono-raised);
      }
      .nav-link.active {
        color: var(--mono-accent);
        border-bottom-color: var(--mono-accent);
      }
      .modal {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.7);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
      }
      .modal.hidden {
        display: none;
      }
      .modal-content {
        background-color: var(--mono-surface);
        border: 1px solid var(--mono-raised);
        border-radius: 8px;
        padding: 24px;
        width: 100%;
        max-width: 500px;
        margin: 16px;
        max-height: 90vh;
        overflow-y: auto;
      }
      .form-input {
        background-color: var(--mono-raised);
        border: 1px solid var(--mono-muted);
        color: var(--mono-text);
        padding: 8px 12px;
        border-radius: 4px;
        width: 100%;
        box-sizing: border-box;
      }
      .form-input:focus {
        outline: none;
        border-color: var(--mono-accent);
      }
      .tech-tag {
        background-color: var(--mono-raised);
        color: var(--mono-accent);
        padding: 4px 8px;
        border-radius: 12px;
        font-size: 12px;
        display: inline-block;
        margin: 2px;
      }

      .featured-badge {
        background-color: var(--mono-accent);
        color: var(--mono-bg);
        padding: 4px 8px;
        border-radius: 12px;
        font-size: 12px;
        font-weight: 500;
      }
      .project-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1.5rem;
        align-items: stretch;
      }
      .project-grid > div {
        display: flex;
        flex-direction: column;
        height: 100%;
      }
      .project-grid > div > div:first-child {
        flex: 1;
        display: flex;
        flex-direction: column;
      }

      /* Mobile responsive styles */
      @media (max-width: 768px) {
        .desktop-nav {
          display: none !important;
        }

        .mobile-nav {
          display: flex !important;
          gap: 8px;
        }

        .project-grid {
          grid-template-columns: 1fr;
        }

        .modal-content {
          margin: 8px;
          padding: 16px;
          max-height: 95vh;
        }

        .nav-bg > div {
          padding: 0 8px !important;
        }
      }

      @media (min-width: 769px) {
        .desktop-nav {
          display: flex !important;
        }

        .mobile-nav {
          display: none !important;
        }
      }

      /* Mobile navigation */
      .mobile-nav {
        display: none;
        position: relative;
      }

      .mobile-menu-btn {
        background: none;
        border: none;
        color: var(--mono-text);
        font-size: 18px;
        cursor: pointer;
        padding: 8px;
      }

      .mobile-dropdown {
        position: absolute;
        top: 100%;
        right: 0;
        background: var(--mono-surface);
        border: 1px solid var(--mono-raised);
        border-radius: 8px;
        min-width: 200px;
        z-index: 1000;
        display: none;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
      }

      .mobile-dropdown.show {
        display: block;
      }

      .mobile-dropdown a {
        display: block;
        padding: 12px 16px;
        color: var(--mono-text);
        text-decoration: none;
        border-bottom: 1px solid var(--mono-raised);
        transition: background-color 0.2s;
      }

      .mobile-dropdown a:hover {
        background-color: var(--mono-raised);
      }

      .mobile-dropdown a:last-child {
        border-bottom: none;
      }

      .mobile-dropdown a.active {
        background-color: var(--mono-accent);
        color: var(--mono-bg);
      }
    </style>
  </head>
  <body>
    <nav class="nav-bg">
      <div style="max-width: 1200px; margin: 0 auto; padding: 0 16px;">
        <div
          style="display: flex; justify-content: space-between; align-items: center; height: 64px;"
        >
          <div style="display: flex; align-items: center;">
            <a
              href="/cms"
              style="text-decoration: none; color: var(--mono-text); font-size: 18px; font-weight: bold;"
              >CMS</a
            >
          </div>
          <div
            style="display: flex; margin-left: 24px; gap: 20px; align-items: center;"
            class="desktop-nav"
          >
            <a href="/cms" class="nav-link">Dashboard</a>
            <a href="/cms/experience" class="nav-link">Experience</a>
            <a href="/cms/projects" class="nav-link active">Projects</a>
            <a href="/cms/case-studies" class="nav-link">Case Studies</a>
            <a href="/cms/testimonials" class="nav-link">Testimonials</a>
            <a href="/cms/about" class="nav-link">About</a>
            <a href="/cms/home" class="nav-link">Home</a>
            <a href="/cms/blog" class="nav-link">Blog</a>
          </div>

          <div class="mobile-nav">
            <button class="mobile-menu-btn" onclick="toggleMobileMenu()"
              >☰</button
            >
            <div class="mobile-dropdown" id="mobileDropdown">
              <a href="/cms">Dashboard</a>
              <a href="/cms/experience">Experience</a>
              <a href="/cms/projects" class="active">Projects</a>
              <a href="/cms/case-studies">Case Studies</a>
              <a href="/cms/testimonials">Testimonials</a>
              <a href="/cms/about">About</a>
              <a href="/cms/home">Home</a>
              <a href="/cms/blog">Blog</a>
            </div>
          </div>

          <div style="display: flex; align-items: center; gap: 8px;">
            <span style="font-size: 12px;" class="text-subtle hidden sm:inline"
              >{email}</span
            >
            <form action="/api/auth/signout" method="post">
              <button
                type="submit"
                class="btn-signout"
                style="padding: 6px 12px; font-size: 12px;">Sign out</button
              >
            </form>
          </div>
        </div>
      </div>
    </nav>

    <main style="max-width: 1200px; margin: 0 auto; padding: 16px 8px;">
      <div
        style="border-bottom: 1px solid var(--mono-raised); padding-bottom: 16px; display: flex; flex-direction: column; gap: 16px; margin-bottom: 24px;"
        class="header-section"
      >
        <div
          style="display: flex; justify-content: space-between; align-items: center;"
        >
          <h1 style="font-size: 20px; font-weight: bold; margin: 0;">
            Projects Management
          </h1>
          <button
            onclick="showCreateForm()"
            class="btn-primary"
            style="padding: 8px 12px; font-size: 14px;"
          >
            + Add Project
          </button>
        </div>
      </div>

      {
        error && (
          <div style="background-color: rgba(255, 255, 255, 0.08); border: 1px solid var(--mono-accent); color: var(--mono-accent); padding: 12px; border-radius: 6px; margin-bottom: 16px;">
            Error loading projects: {error.message}
          </div>
        )
      }

      {
        projects && projects.length === 0 && (
          <div style="text-align: center; padding: 48px 0;">
            <div style="font-size: 48px; margin-bottom: 16px; filter: grayscale(1);">
              🚀
            </div>
            <h3 style="margin: 8px 0; font-size: 18px;">No projects</h3>
            <p style="margin: 4px 0; font-size: 14px;" class="text-subtle">
              Get started by adding your first project.
            </p>
          </div>
        )
      }

      {
        projects && projects.length > 0 && (
          <div class="project-grid" id="projectsGrid">
            {projects.map(project => (
              <div class="relative group h-full flex flex-col">
                <div class="flex-1">
                  <ProjectCard
                    title={project.title}
                    description={project.description || ''}
                    technologies={project.technologies || []}
                    period={
                      project.start_date
                        ? `${project.start_date}${project.end_date ? ` - ${project.end_date}` : ''}`
                        : undefined
                    }
                    category={project.category || undefined}
                    demoLink={project.live_url || undefined}
                    githubLink={project.github_url || undefined}
                    highlights={project.is_featured ? ['Featured'] : []}
                  />
                </div>
                <div class="absolute top-4 right-4 opacity-0 group-hover:opacity-100 transition-opacity duration-200 flex gap-2">
                  <button
                    onclick={`editProject('${project.id}')`}
                    class="btn-edit px-3 py-1 text-xs"
                  >
                    Edit
                  </button>
                  <button
                    onclick={`deleteProject('${project.id}')`}
                    class="btn-delete px-3 py-1 text-xs"
                  >
                    Delete
                  </button>
                </div>
              </div>
            ))}
          </div>
        )
      }
    </main>

    <!-- Modal -->
    <div id="projectModal" class="modal hidden">
      <div class="modal-content">
        <h2
          id="modalTitle"
          style="font-size: 20px; font-weight: bold; margin: 0 0 16px 0;"
        >
          Add Project
        </h2>
        <form id="projectForm">
          <input type="hidden" id="projectId" />

          <div style="margin-bottom: 16px;">
            <label
              style="display: block; font-size: 14px; font-weight: 500; margin-bottom: 4px;"
              >Project Title</label
            >
            <input type="text" id="title" required class="form-input" />
          </div>

          <div style="margin-bottom: 16px;">
            <label
              style="display: block; font-size: 14px; font-weight: 500; margin-bottom: 4px;"
              >Description</label
            >
            <textarea id="description" rows="4" class="form-input"></textarea>
          </div>

          <div style="margin-bottom: 16px;">
            <label
              style="display: block; font-size: 14px; font-weight: 500; margin-bottom: 4px;"
              >Technologies (comma-separated)</label
            >
            <input
              type="text"
              id="technologies"
              placeholder="React, TypeScript, Node.js"
              class="form-input"
            />
          </div>

          <div style="margin-bottom: 16px;">
            <label
              style="display: block; font-size: 14px; font-weight: 500; margin-bottom: 4px;"
              >GitHub URL</label
            >
            <input type="url" id="githubUrl" class="form-input" />
          </div>

          <div style="margin-bottom: 16px;">
            <label
              style="display: block; font-size: 14px; font-weight: 500; margin-bottom: 4px;"
              >Live Demo URL</label
            >
            <input type="url" id="liveUrl" class="form-input" />
          </div>

          <div style="margin-bottom: 16px;">
            <label
              style="display: block; font-size: 14px; font-weight: 500; margin-bottom: 4px;"
              >Image URL</label
            >
            <input type="url" id="imageUrl" class="form-input" />
          </div>

          <div style="margin-bottom: 24px;">
            <label style="display: flex; align-items: center; gap: 8px;">
              <input
                type="checkbox"
                id="featured"
                style="accent-color: var(--mono-accent);"
              />
              <span style="font-size: 14px; font-weight: 500;"
                >Featured Project</span
              >
            </label>
          </div>

          <div style="display: flex; justify-content: flex-end; gap: 12px;">
            <button
              type="button"
              onclick="closeModal()"
              style="background: none; border: 1px solid var(--mono-muted); color: var(--mono-subtle); padding: 8px 16px; border-radius: 4px; cursor: pointer;"
              >Cancel</button
            >
            <button type="submit" class="btn-primary">Save Project</button>
          </div>
        </form>
      </div>
    </div>

    <script is:inline>
      let currentProjectId = null;

      // Mobile menu functionality
      window.toggleMobileMenu = function () {
        const dropdown = document.getElementById('mobileDropdown');
        dropdown.classList.toggle('show');
      };

      // Close mobile menu when clicking outside
      document.addEventListener('click', function (event) {
        const dropdown = document.getElementById('mobileDropdown');
        const menuBtn = document.querySelector('.mobile-menu-btn');

        if (
          !dropdown.contains(event.target) &&
          !menuBtn.contains(event.target)
        ) {
          dropdown.classList.remove('show');
        }
      });

      // Make functions globally accessible
      window.showCreateForm = function () {
        document.getElementById('modalTitle').textContent = 'Add Project';
        document.getElementById('projectForm').reset();
        document.getElementById('projectId').value = '';
        currentProjectId = null;
        document.getElementById('projectModal').classList.remove('hidden');
      };

      window.editProject = async function (id) {
        try {
          const response = await fetch(`/api/project/${id}`);
          const project = await response.json();

          document.getElementById('modalTitle').textContent = 'Edit Project';
          document.getElementById('projectId').value = project.id;
          document.getElementById('title').value = project.title;
          document.getElementById('description').value =
            project.description || '';
          document.getElementById('technologies').value = project.technologies
            ? project.technologies.join(', ')
            : '';
          document.getElementById('githubUrl').value = project.github_url || '';
          document.getElementById('liveUrl').value = project.live_url || '';
          document.getElementById('imageUrl').value = project.image_url || '';
          document.getElementById('featured').checked =
            project.is_featured || false;

          currentProjectId = id;
          document.getElementById('projectModal').classList.remove('hidden');
        } catch (error) {
          alert('Error loading project: ' + error.message);
        }
      };

      window.deleteProject = async function (id) {
        if (!confirm('Are you sure you want to delete this project?')) {
          return;
        }

        try {
          const response = await fetch(`/api/project/${id}`, {
            method: 'DELETE',
          });

          if (response.ok) {
            window.location.reload();
          } else {
            const error = await response.json();
            alert('Error deleting project: ' + error.error);
          }
        } catch (error) {
          alert('Error deleting project: ' + error.message);
        }
      };

      window.closeModal = function () {
        document.getElementById('projectModal').classList.add('hidden');
      };

      document
        .getElementById('projectForm')
        .addEventListener('submit', async e => {
          e.preventDefault();

          const formData = {
            title: document.getElementById('title').value,
            description: document.getElementById('description').value || null,
            technologies: document.getElementById('technologies').value
              ? document
                  .getElementById('technologies')
                  .value.split(',')
                  .map(t => t.trim())
                  .filter(t => t)
              : [],
            github_url: document.getElementById('githubUrl').value || null,
            live_url: document.getElementById('liveUrl').value || null,
            image_url: document.getElementById('imageUrl').value || null,
            is_featured: document.getElementById('featured').checked,
          };

          try {
            const url = currentProjectId
              ? `/api/project/${currentProjectId}`
              : '/api/project/';
            const method = currentProjectId ? 'PUT' : 'POST';

            const response = await fetch(url, {
              method: method,
              headers: {
                'Content-Type': 'application/json',
              },
              body: JSON.stringify(formData),
            });

            if (response.ok) {
              window.location.reload();
            } else {
              const error = await response.json();
              alert('Error saving project: ' + error.error);
            }
          } catch (error) {
            alert('Error saving project: ' + error.message);
          }
        });

      // Close modal when clicking outside
      document.getElementById('projectModal').addEventListener('click', e => {
        if (e.target === e.currentTarget) {
          window.closeModal();
        }
      });
    </script>
  </body>
</html>
