---
import { supabase } from '@/libs/supabase';

const { cookies, redirect } = Astro;
const accessToken = cookies.get('sb-access-token');
const refreshToken = cookies.get('sb-refresh-token');

if (!accessToken || !refreshToken) {
  return redirect('/login');
}

let session;
try {
  session = await supabase.auth.setSession({
    refresh_token: refreshToken.value,
    access_token: accessToken.value,
  });
  if (session.error) {
    return redirect('/login');
  }
} catch {
  return redirect('/login');
}

const { data: caseStudies, error } = await supabase
  .from('case_studies')
  .select('*')
  .order('created_at', { ascending: false });

const email = session.data.user?.email;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Case Studies Management - CMS</title>
    <meta name="description" content="Manage portfolio case studies" />
    <meta name="robots" content="noindex, nofollow" />
    <style>
      :root {
        --rp-base: #191724;
        --rp-surface: #1f1d2e;
        --rp-overlay: #26233a;
        --rp-muted: #6e6a86;
        --rp-subtle: #908caa;
        --rp-text: #e0def4;
        --rp-love: #eb6f92;
        --rp-gold: #f6c177;
        --rp-rose: #ebbcba;
        --rp-pine: #31748f;
        --rp-foam: #9ccfd8;
        --rp-iris: #c4a7e7;
      }
      body {
        background-color: var(--rp-base);
        color: var(--rp-text);
        font-family:
          system-ui,
          -apple-system,
          sans-serif;
        margin: 0;
        padding: 0;
      }
      .nav-bg {
        background-color: var(--rp-surface);
        border-bottom: 1px solid var(--rp-overlay);
      }
      .card-bg {
        background-color: var(--rp-surface);
        border: 1px solid var(--rp-overlay);
      }
      .btn-primary {
        background-color: var(--rp-pine);
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.2s;
      }
      .btn-primary:hover {
        background-color: var(--rp-foam);
        color: var(--rp-base);
      }
      .btn-edit {
        background-color: var(--rp-iris);
        color: white;
        border: none;
        padding: 6px 12px;
        border-radius: 4px;
        cursor: pointer;
        transition: all 0.2s;
      }
      .btn-edit:hover {
        background-color: var(--rp-rose);
      }
      .btn-delete {
        background-color: var(--rp-love);
        color: white;
        border: none;
        padding: 6px 12px;
        border-radius: 4px;
        cursor: pointer;
        transition: all 0.2s;
      }
      .btn-delete:hover {
        background-color: #d4556a;
      }
      .btn-signout {
        background-color: var(--rp-love);
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 6px;
        cursor: pointer;
      }
      .btn-signout:hover {
        background-color: #d4556a;
      }
      .text-muted {
        color: var(--rp-muted);
      }
      .text-subtle {
        color: var(--rp-subtle);
      }
      .nav-link {
        color: var(--rp-subtle);
        border-bottom: 2px solid transparent;
        text-decoration: none;
        padding: 8px 4px;
        transition: all 0.2s;
      }
      .nav-link:hover {
        color: var(--rp-text);
        border-bottom-color: var(--rp-overlay);
      }
      .nav-link.active {
        color: var(--rp-pine);
        border-bottom-color: var(--rp-pine);
      }
      .modal {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.7);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
      }
      .modal.hidden {
        display: none;
      }
      .modal-content {
        background-color: var(--rp-surface);
        border: 1px solid var(--rp-overlay);
        border-radius: 8px;
        padding: 24px;
        width: 100%;
        max-width: 600px;
        margin: 16px;
        max-height: 90vh;
        overflow-y: auto;
      }
      .form-input {
        background-color: var(--rp-overlay);
        border: 1px solid var(--rp-muted);
        color: var(--rp-text);
        padding: 8px 12px;
        border-radius: 4px;
        width: 100%;
        box-sizing: border-box;
      }
      .form-input:focus {
        outline: none;
        border-color: var(--rp-pine);
      }
      .tech-tag {
        background-color: var(--rp-overlay);
        color: var(--rp-foam);
        padding: 4px 8px;
        border-radius: 12px;
        font-size: 12px;
        display: inline-block;
        margin: 2px;
      }
      .featured-badge {
        background-color: var(--rp-love);
        color: white;
        padding: 4px 8px;
        border-radius: 12px;
        font-size: 12px;
        font-weight: 500;
      }
      .case-study-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
        gap: 1.5rem;
        align-items: stretch;
      }
      .case-study-card {
        display: flex;
        flex-direction: column;
        height: 100%;
        position: relative;
        transition: all 0.2s;
      }
      .case-study-card:hover {
        transform: translateY(-2px);
      }
      .case-study-content {
        flex: 1;
        padding: 20px;
      }
      .results-list {
        list-style: none;
        padding: 0;
        margin: 0;
      }
      .results-list li {
        padding: 4px 0;
        position: relative;
        padding-left: 16px;
      }
      .results-list li::before {
        content: '✓';
        position: absolute;
        left: 0;
        color: var(--rp-foam);
        font-weight: bold;
      }
    </style>
  </head>
  <body>
    <nav class="nav-bg">
      <div style="max-width: 1200px; margin: 0 auto; padding: 0 16px;">
        <div
          style="display: flex; justify-content: space-between; height: 64px;"
        >
          <div style="display: flex;">
            <div style="display: flex; align-items: center;">
              <a
                href="/cms"
                style="text-decoration: none; color: var(--rp-text); font-size: 20px; font-weight: bold;"
                >🌹 CMS</a
              >
            </div>
            <div
              style="display: flex; margin-left: 24px; gap: 32px; align-items: center;"
            >
              <a href="/cms" class="nav-link">Dashboard</a>
              <a href="/cms/experience" class="nav-link">Experience</a>
              <a href="/cms/projects" class="nav-link">Projects</a>
              <a href="/cms/case-studies" class="nav-link active"
                >Case Studies</a
              >
              <a href="/cms/testimonials" class="nav-link">Testimonials</a>
              <a href="/cms/about" class="nav-link">About</a>
              <a href="/cms/home" class="nav-link">Home</a>
            </div>
          </div>
          <div style="display: flex; align-items: center; gap: 16px;">
            <span style="font-size: 14px;" class="text-subtle">{email}</span>
            <form action="/api/auth/signout" method="post">
              <button type="submit" class="btn-signout">Sign out</button>
            </form>
          </div>
        </div>
      </div>
    </nav>

    <main style="max-width: 1200px; margin: 0 auto; padding: 24px 16px;">
      <div
        style="border-bottom: 1px solid var(--rp-overlay); padding-bottom: 20px; display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;"
      >
        <h1 style="font-size: 24px; font-weight: bold; margin: 0;">
          Case Studies Management
        </h1>
        <button onclick="showCreateForm()" class="btn-primary"
          >+ Add Case Study</button
        >
      </div>

      {
        error && (
          <div style="background-color: rgba(235, 111, 146, 0.2); border: 1px solid var(--rp-love); color: var(--rp-love); padding: 12px; border-radius: 6px; margin-bottom: 16px;">
            Error loading case studies: {error.message}
          </div>
        )
      }

      {
        caseStudies && caseStudies.length === 0 && (
          <div style="text-align: center; padding: 48px 0;">
            <div style="font-size: 48px; margin-bottom: 16px;">📊</div>
            <h3 style="margin: 8px 0; font-size: 18px;">No case studies</h3>
            <p style="margin: 4px 0; font-size: 14px;" class="text-subtle">
              Get started by adding your first case study.
            </p>
          </div>
        )
      }

      {
        caseStudies && caseStudies.length > 0 && (
          <div class="case-study-grid" id="caseStudiesGrid">
            {caseStudies.map(study => (
              <div class="case-study-card card-bg rounded-lg">
                <div class="case-study-content">
                  <div style="display: flex; justify-content: between; align-items: start; margin-bottom: 12px;">
                    <h3 style="font-size: 18px; font-weight: bold; margin: 0; flex: 1;">
                      {study.title}
                    </h3>
                    {study.is_featured && (
                      <span class="featured-badge" style="margin-left: 8px;">
                        Featured
                      </span>
                    )}
                  </div>

                  <div
                    style="display: flex; gap: 16px; margin-bottom: 16px; font-size: 14px;"
                    class="text-subtle"
                  >
                    <span>📝 {study.client}</span>
                    <span>⏱️ {study.duration}</span>
                  </div>

                  <div style="margin-bottom: 16px;">
                    <h4 style="font-size: 14px; font-weight: 600; margin: 0 0 8px 0;">
                      Challenge:
                    </h4>
                    <p
                      style="font-size: 14px; margin: 0; line-height: 1.4;"
                      class="text-subtle"
                    >
                      {study.challenge}
                    </p>
                  </div>

                  <div style="margin-bottom: 16px;">
                    <h4 style="font-size: 14px; font-weight: 600; margin: 0 0 8px 0;">
                      Solution:
                    </h4>
                    <p
                      style="font-size: 14px; margin: 0; line-height: 1.4;"
                      class="text-subtle"
                    >
                      {study.solution}
                    </p>
                  </div>

                  {study.technologies && study.technologies.length > 0 && (
                    <div style="margin-bottom: 16px;">
                      <h4 style="font-size: 14px; font-weight: 600; margin: 0 0 8px 0;">
                        Technologies:
                      </h4>
                      <div style="display: flex; flex-wrap: wrap; gap: 4px;">
                        {study.technologies.map(tech => (
                          <span class="tech-tag">{tech}</span>
                        ))}
                      </div>
                    </div>
                  )}

                  {study.results && study.results.length > 0 && (
                    <div style="margin-bottom: 16px;">
                      <h4 style="font-size: 14px; font-weight: 600; margin: 0 0 8px 0;">
                        Key Results:
                      </h4>
                      <ul class="results-list">
                        {study.results.map(result => (
                          <li style="font-size: 14px;" class="text-subtle">
                            {result}
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                </div>

                <div style="padding: 0 20px 20px; display: flex; justify-content: flex-end; gap: 8px;">
                  <button
                    onclick={`editCaseStudy('${study.id}')`}
                    class="btn-edit px-3 py-1 text-xs"
                  >
                    Edit
                  </button>
                  <button
                    onclick={`deleteCaseStudy('${study.id}')`}
                    class="btn-delete px-3 py-1 text-xs"
                  >
                    Delete
                  </button>
                </div>
              </div>
            ))}
          </div>
        )
      }
    </main>

    <div id="caseStudyModal" class="modal hidden">
      <div class="modal-content">
        <h2
          id="modalTitle"
          style="font-size: 20px; font-weight: bold; margin: 0 0 16px 0;"
        >
          Add Case Study
        </h2>
        <form id="caseStudyForm">
          <input type="hidden" id="caseStudyId" />

          <div style="margin-bottom: 16px;">
            <label
              style="display: block; font-size: 14px; font-weight: 500; margin-bottom: 4px;"
            >
              Case Study Title
            </label>
            <input type="text" id="title" required class="form-input" />
          </div>

          <div style="margin-bottom: 16px;">
            <label
              style="display: block; font-size: 14px; font-weight: 500; margin-bottom: 4px;"
            >
              Client
            </label>
            <input type="text" id="client" required class="form-input" />
          </div>

          <div style="margin-bottom: 16px;">
            <label
              style="display: block; font-size: 14px; font-weight: 500; margin-bottom: 4px;"
            >
              Duration
            </label>
            <input
              type="text"
              id="duration"
              placeholder="6 months"
              required
              class="form-input"
            />
          </div>

          <div style="margin-bottom: 16px;">
            <label
              style="display: block; font-size: 14px; font-weight: 500; margin-bottom: 4px;"
            >
              Technologies (comma-separated)
            </label>
            <input
              type="text"
              id="technologies"
              placeholder="React, TypeScript, Node.js"
              class="form-input"
            />
          </div>

          <div style="margin-bottom: 16px;">
            <label
              style="display: block; font-size: 14px; font-weight: 500; margin-bottom: 4px;"
            >
              Challenge
            </label>
            <textarea id="challenge" rows="3" required class="form-input"
            ></textarea>
          </div>

          <div style="margin-bottom: 16px;">
            <label
              style="display: block; font-size: 14px; font-weight: 500; margin-bottom: 4px;"
            >
              Solution
            </label>
            <textarea id="solution" rows="4" required class="form-input"
            ></textarea>
          </div>

          <div style="margin-bottom: 16px;">
            <label
              style="display: block; font-size: 14px; font-weight: 500; margin-bottom: 4px;"
            >
              Key Results (one per line)
            </label>
            <textarea
              id="results"
              rows="4"
              placeholder="75% improvement in page load times
40% increase in conversion rates"
              class="form-input"></textarea>
          </div>

          <div style="margin-bottom: 24px;">
            <label style="display: flex; align-items: center; gap: 8px;">
              <input
                type="checkbox"
                id="featured"
                style="accent-color: var(--rp-pine);"
              />
              <span style="font-size: 14px; font-weight: 500;"
                >Featured Case Study</span
              >
            </label>
          </div>

          <div style="display: flex; justify-content: flex-end; gap: 12px;">
            <button
              type="button"
              onclick="closeModal()"
              style="background: none; border: 1px solid var(--rp-muted); color: var(--rp-subtle); padding: 8px 16px; border-radius: 4px; cursor: pointer;"
            >
              Cancel
            </button>
            <button type="submit" class="btn-primary">Save Case Study</button>
          </div>
        </form>
      </div>
    </div>

    <script is:inline>
      let currentCaseStudyId = null;

      window.showCreateForm = function () {
        document.getElementById('modalTitle').textContent = 'Add Case Study';
        document.getElementById('caseStudyForm').reset();
        document.getElementById('caseStudyId').value = '';
        currentCaseStudyId = null;
        document.getElementById('caseStudyModal').classList.remove('hidden');
      };

      window.editCaseStudy = async function (id) {
        try {
          const response = await fetch(`/api/case-study/${id}`);
          const caseStudy = await response.json();

          document.getElementById('modalTitle').textContent = 'Edit Case Study';
          document.getElementById('caseStudyId').value = caseStudy.id;
          document.getElementById('title').value = caseStudy.title;
          document.getElementById('client').value = caseStudy.client || '';
          document.getElementById('duration').value = caseStudy.duration || '';
          document.getElementById('technologies').value = caseStudy.technologies
            ? caseStudy.technologies.join(', ')
            : '';
          document.getElementById('challenge').value =
            caseStudy.challenge || '';
          document.getElementById('solution').value = caseStudy.solution || '';
          document.getElementById('results').value = caseStudy.results
            ? caseStudy.results.join('\n')
            : '';
          document.getElementById('featured').checked =
            caseStudy.is_featured || false;

          currentCaseStudyId = id;
          document.getElementById('caseStudyModal').classList.remove('hidden');
        } catch (error) {
          alert('Error loading case study: ' + error.message);
        }
      };

      window.deleteCaseStudy = async function (id) {
        if (!confirm('Are you sure you want to delete this case study?')) {
          return;
        }

        try {
          const response = await fetch(`/api/case-study/${id}`, {
            method: 'DELETE',
          });

          if (response.ok) {
            window.location.reload();
          } else {
            const error = await response.json();
            alert('Error deleting case study: ' + error.error);
          }
        } catch (error) {
          alert('Error deleting case study: ' + error.message);
        }
      };

      window.closeModal = function () {
        document.getElementById('caseStudyModal').classList.add('hidden');
      };

      document
        .getElementById('caseStudyForm')
        .addEventListener('submit', async e => {
          e.preventDefault();

          const formData = {
            title: document.getElementById('title').value,
            client: document.getElementById('client').value || null,
            duration: document.getElementById('duration').value || null,
            technologies: document.getElementById('technologies').value
              ? document
                  .getElementById('technologies')
                  .value.split(',')
                  .map(t => t.trim())
                  .filter(t => t)
              : [],
            challenge: document.getElementById('challenge').value || null,
            solution: document.getElementById('solution').value || null,
            results: document.getElementById('results').value
              ? document
                  .getElementById('results')
                  .value.split('\n')
                  .map(r => r.trim())
                  .filter(r => r)
              : [],
            is_featured: document.getElementById('featured').checked,
          };

          try {
            let response;
            if (currentCaseStudyId) {
              response = await fetch(`/api/case-study/${currentCaseStudyId}`, {
                method: 'PUT',
                headers: {
                  'Content-Type': 'application/json',
                },
                body: JSON.stringify(formData),
              });
            } else {
              response = await fetch('/api/case-study', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                },
                body: JSON.stringify(formData),
              });
            }

            if (response.ok) {
              window.location.reload();
            } else {
              const error = await response.json();
              alert('Error saving case study: ' + error.error);
            }
          } catch (error) {
            alert('Error saving case study: ' + error.message);
          }
        });
    </script>
  </body>
</html>
