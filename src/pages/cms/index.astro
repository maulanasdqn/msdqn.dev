---
import { getSessionUser } from '@/libs/auth';

const user = await getSessionUser(Astro.locals, Astro.cookies);
if (!user) {
  return Astro.redirect('/login');
}

const email = user.email;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CMS Dashboard</title>
    <meta name="description" content="Content management system dashboard" />
    <style>
      :root {
        --rp-base: #191724;
        --rp-surface: #1f1d2e;
        --rp-overlay: #26233a;
        --rp-muted: #6e6a86;
        --rp-subtle: #908caa;
        --rp-text: #e0def4;
        --rp-love: #eb6f92;
        --rp-gold: #f6c177;
        --rp-rose: #ebbcba;
        --rp-pine: #31748f;
        --rp-foam: #9ccfd8;
        --rp-iris: #c4a7e7;
      }
      body {
        background-color: var(--rp-base);
        color: var(--rp-text);
      }
      .nav-bg {
        background-color: var(--rp-surface);
        border-bottom: 1px solid var(--rp-overlay);
      }
      .card-bg {
        background-color: var(--rp-surface);
        border: 1px solid var(--rp-overlay);
      }
      .card-bg:hover {
        background-color: var(--rp-overlay);
      }
      .btn-signout {
        background-color: var(--rp-love);
      }
      .btn-signout:hover {
        background-color: #d4556a;
      }
      .text-muted {
        color: var(--rp-muted);
      }
      .text-subtle {
        color: var(--rp-subtle);
      }
      .link-pine {
        color: var(--rp-pine);
      }
      .link-pine:hover {
        color: var(--rp-foam);
      }
      .icon-iris {
        background-color: var(--rp-iris);
      }
      .icon-pine {
        background-color: var(--rp-pine);
      }
      .icon-love {
        background-color: var(--rp-love);
      }
      .icon-gold {
        background-color: var(--rp-gold);
      }
      .icon-rose {
        background-color: var(--rp-rose);
      }
    </style>
  </head>
  <body class="min-h-screen">
    <nav class="nav-bg shadow-lg">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
          <div class="flex items-center">
            <h1 class="text-lg sm:text-xl font-bold">🌹 CMS</h1>
          </div>
          <div class="flex items-center space-x-2 sm:space-x-4">
            <span class="text-xs sm:text-sm text-subtle hidden sm:inline"
              >{email}</span
            >
            <form action="/api/auth/signout" method="post">
              <button
                class="btn-signout text-white px-2 py-1 sm:px-3 sm:py-2 rounded-md text-xs sm:text-sm font-medium transition-colors"
              >
                Sign Out
              </button>
            </form>
          </div>
        </div>
      </div>
    </nav>

    <main class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
      <div class="px-4 py-6 sm:px-0">
        <div class="mb-8">
          <h2 class="text-2xl font-bold">Welcome to your CMS</h2>
          <p class="mt-2 text-subtle">
            Manage your portfolio content from here.
          </p>
        </div>

        <div
          class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"
        >
          <div
            class="card-bg overflow-hidden shadow-lg rounded-lg transition-colors"
          >
            <div class="p-5">
              <div class="flex items-center">
                <div class="flex-shrink-0">
                  <div
                    class="w-8 h-8 icon-iris rounded-md flex items-center justify-center"
                  >
                    <svg
                      class="w-5 h-5 text-white"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2-2v2m8 0V6a2 2 0 012 2v6M8 6V4a2 2 0 012-2h4a2 2 0 012 2v2m-8 0V6a2 2 0 00-2 2v6"
                      ></path>
                    </svg>
                  </div>
                </div>
                <div class="ml-5 w-0 flex-1">
                  <dt class="text-sm font-medium text-muted truncate">
                    Experience
                  </dt>
                  <dd class="text-lg font-medium">Work History</dd>
                </div>
              </div>
              <div class="mt-3">
                <a
                  href="/cms/experience"
                  class="text-sm font-medium link-pine transition-colors"
                >
                  Manage experiences →
                </a>
              </div>
            </div>
          </div>

          <div
            class="card-bg overflow-hidden shadow-lg rounded-lg transition-colors"
          >
            <div class="p-5">
              <div class="flex items-center">
                <div class="flex-shrink-0">
                  <div
                    class="w-8 h-8 icon-pine rounded-md flex items-center justify-center"
                  >
                    <svg
                      class="w-5 h-5 text-white"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"
                      ></path>
                    </svg>
                  </div>
                </div>
                <div class="ml-5 w-0 flex-1">
                  <dt class="text-sm font-medium text-muted truncate">
                    Projects
                  </dt>
                  <dd class="text-lg font-medium">Portfolio</dd>
                </div>
              </div>
              <div class="mt-3">
                <a
                  href="/cms/projects"
                  class="text-sm font-medium link-pine transition-colors"
                >
                  Manage projects →
                </a>
              </div>
            </div>
          </div>

          <div
            class="card-bg overflow-hidden shadow-lg rounded-lg transition-colors"
          >
            <div class="p-5">
              <div class="flex items-center">
                <div class="flex-shrink-0">
                  <div
                    class="w-8 h-8 icon-love rounded-md flex items-center justify-center"
                  >
                    <svg
                      class="w-5 h-5 text-white"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                      ></path>
                    </svg>
                  </div>
                </div>
                <div class="ml-5 w-0 flex-1">
                  <dt class="text-sm font-medium text-muted truncate">About</dt>
                  <dd class="text-lg font-medium">Personal Info</dd>
                </div>
              </div>
              <div class="mt-3">
                <a
                  href="/cms/about"
                  class="text-sm font-medium link-pine transition-colors"
                >
                  Edit about page →
                </a>
              </div>
            </div>
          </div>

          <div
            class="card-bg overflow-hidden shadow-lg rounded-lg transition-colors"
          >
            <div class="p-5">
              <div class="flex items-center">
                <div class="flex-shrink-0">
                  <div
                    class="w-8 h-8 icon-rose rounded-md flex items-center justify-center"
                  >
                    <svg
                      class="w-5 h-5 text-white"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                      ></path>
                    </svg>
                  </div>
                </div>
                <div class="ml-5 w-0 flex-1">
                  <dt class="text-sm font-medium text-muted truncate">
                    Case Studies
                  </dt>
                  <dd class="text-lg font-medium">Portfolio Studies</dd>
                </div>
              </div>
              <div class="mt-3">
                <a
                  href="/cms/case-studies"
                  class="text-sm font-medium link-pine transition-colors"
                >
                  Manage case studies →
                </a>
              </div>
            </div>
          </div>

          <div
            class="card-bg overflow-hidden shadow-lg rounded-lg transition-colors"
          >
            <div class="p-5">
              <div class="flex items-center">
                <div class="flex-shrink-0">
                  <div
                    class="w-8 h-8 icon-gold rounded-md flex items-center justify-center"
                  >
                    <svg
                      class="w-5 h-5 text-white"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
                      ></path>
                    </svg>
                  </div>
                </div>
                <div class="ml-5 w-0 flex-1">
                  <dt class="text-sm font-medium text-muted truncate">Home</dt>
                  <dd class="text-lg font-medium">Homepage</dd>
                </div>
              </div>
              <div class="mt-3">
                <a
                  href="/cms/home"
                  class="text-sm font-medium link-pine transition-colors"
                >
                  Edit homepage →
                </a>
              </div>
            </div>
          </div>

          <div
            class="card-bg overflow-hidden shadow-lg rounded-lg transition-colors"
          >
            <div class="p-5">
              <div class="flex items-center">
                <div class="flex-shrink-0">
                  <div
                    class="w-8 h-8 icon-foam rounded-md flex items-center justify-center"
                    style="background-color: var(--rp-foam);"
                  >
                    <svg
                      class="w-5 h-5 text-white"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
                      ></path>
                    </svg>
                  </div>
                </div>
                <div class="ml-5 w-0 flex-1">
                  <dt class="text-sm font-medium text-muted truncate">
                    Testimonials
                  </dt>
                  <dd class="text-lg font-medium">Client Feedback</dd>
                </div>
              </div>
              <div class="mt-3">
                <a
                  href="/cms/testimonials"
                  class="text-sm font-medium link-pine transition-colors"
                >
                  Manage testimonials →
                </a>
              </div>
            </div>
          </div>

          <div
            class="card-bg overflow-hidden shadow-lg rounded-lg transition-colors"
          >
            <div class="p-5">
              <div class="flex items-center">
                <div class="flex-shrink-0">
                  <div
                    class="w-8 h-8 rounded-md flex items-center justify-center"
                    style="background-color: var(--rp-pine);"
                  >
                    <svg
                      class="w-5 h-5 text-white"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                      ></path>
                    </svg>
                  </div>
                </div>
                <div class="ml-5 w-0 flex-1">
                  <dt class="text-sm font-medium text-muted truncate">
                    Blog Posts
                  </dt>
                  <dd class="text-lg font-medium">Tech Articles</dd>
                </div>
              </div>
              <div class="mt-3">
                <a
                  href="/cms/blog"
                  class="text-sm font-medium link-pine transition-colors"
                >
                  Manage blog posts →
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>
  </body>
</html>
