---
import { supabase } from '@/libs/supabase';

const { cookies, redirect } = Astro;
const accessToken = cookies.get('sb-access-token');
const refreshToken = cookies.get('sb-refresh-token');

if (!accessToken || !refreshToken) {
  return redirect('/login');
}

let session;
try {
  session = await supabase.auth.setSession({
    refresh_token: refreshToken.value,
    access_token: accessToken.value,
  });
  if (session.error) {
    return redirect('/login');
  }
} catch {
  return redirect('/login');
}

const { data: testimonials, error } = await supabase
  .from('testimonials')
  .select('*')
  .order('created_at', { ascending: false });

const email = session.data.user?.email;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Testimonials Management - CMS</title>
    <meta name="description" content="Manage client testimonials" />
    <style>
      :root {
        --rp-base: #191724;
        --rp-surface: #1f1d2e;
        --rp-overlay: #26233a;
        --rp-muted: #6e6a86;
        --rp-subtle: #908caa;
        --rp-text: #e0def4;
        --rp-love: #eb6f92;
        --rp-gold: #f6c177;
        --rp-rose: #ebbcba;
        --rp-pine: #31748f;
        --rp-foam: #9ccfd8;
        --rp-iris: #c4a7e7;
      }
      body {
        background-color: var(--rp-base);
        color: var(--rp-text);
        font-family:
          system-ui,
          -apple-system,
          sans-serif;
      }
      .nav-bg {
        background-color: var(--rp-surface);
        border-bottom: 1px solid var(--rp-overlay);
      }
      .card-bg {
        background-color: var(--rp-surface);
        border: 1px solid var(--rp-overlay);
      }
      .btn-primary {
        background-color: var(--rp-pine);
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.2s;
      }
      .btn-primary:hover {
        background-color: var(--rp-foam);
        color: var(--rp-base);
      }
      .btn-edit {
        background-color: var(--rp-iris);
        color: white;
        border: none;
        padding: 6px 12px;
        border-radius: 4px;
        cursor: pointer;
        transition: all 0.2s;
      }
      .btn-edit:hover {
        background-color: var(--rp-rose);
      }
      .btn-delete {
        background-color: var(--rp-love);
        color: white;
        border: none;
        padding: 6px 12px;
        border-radius: 4px;
        cursor: pointer;
        transition: all 0.2s;
      }
      .btn-delete:hover {
        background-color: #d4556a;
      }
      .btn-signout {
        background-color: var(--rp-love);
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 6px;
        cursor: pointer;
      }
      .btn-signout:hover {
        background-color: #d4556a;
      }
      .text-muted {
        color: var(--rp-muted);
      }
      .text-subtle {
        color: var(--rp-subtle);
      }
      .nav-link {
        color: var(--rp-subtle);
        border-bottom: 2px solid transparent;
        text-decoration: none;
        padding: 8px 4px;
        transition: all 0.2s;
      }
      .nav-link:hover {
        color: var(--rp-text);
        border-bottom-color: var(--rp-overlay);
      }
      .nav-link.active {
        color: var(--rp-pine);
        border-bottom-color: var(--rp-pine);
      }
      .modal {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.7);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
      }
      .modal.hidden {
        display: none;
      }
      .modal-content {
        background-color: var(--rp-surface);
        border: 1px solid var(--rp-overlay);
        border-radius: 8px;
        padding: 24px;
        width: 100%;
        max-width: 500px;
        margin: 16px;
        max-height: 90vh;
        overflow-y: auto;
      }
      .form-input {
        background-color: var(--rp-overlay);
        border: 1px solid var(--rp-muted);
        color: var(--rp-text);
        padding: 8px 12px;
        border-radius: 4px;
        width: 100%;
      }
      .form-input:focus {
        outline: none;
        border-color: var(--rp-pine);
      }
      .star-rating {
        color: var(--rp-foam);
        font-size: 16px;
      }
    </style>
  </head>
  <body class="min-h-screen">
    <nav class="nav-bg shadow-lg">
      <div style="max-width: 1200px; margin: 0 auto; padding: 0 16px;">
        <div
          style="display: flex; justify-content: space-between; height: 64px;"
        >
          <div style="display: flex;">
            <div style="display: flex; align-items: center;">
              <a
                href="/cms"
                style="text-decoration: none; color: var(--rp-text); font-size: 20px; font-weight: bold;"
                >🌹 CMS</a
              >
            </div>
            <div
              style="display: flex; margin-left: 24px; gap: 32px; align-items: center;"
            >
              <a href="/cms" class="nav-link">Dashboard</a>
              <a href="/cms/experience" class="nav-link">Experience</a>
              <a href="/cms/projects" class="nav-link">Projects</a>
              <a href="/cms/case-studies" class="nav-link">Case Studies</a>
              <a href="/cms/testimonials" class="nav-link active"
                >Testimonials</a
              >
              <a href="/cms/about" class="nav-link">About</a>
              <a href="/cms/home" class="nav-link">Home</a>
            </div>
          </div>
          <div style="display: flex; align-items: center; gap: 16px;">
            <span style="font-size: 14px;" class="text-subtle">{email}</span>
            <form action="/api/auth/signout" method="post">
              <button type="submit" class="btn-signout">Sign out</button>
            </form>
          </div>
        </div>
      </div>
    </nav>

    <main style="max-width: 1200px; margin: 0 auto; padding: 24px 16px;">
      <div
        style="border-bottom: 1px solid var(--rp-overlay); padding-bottom: 20px; display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;"
      >
        <h1 style="font-size: 24px; font-weight: bold; margin: 0;">
          Testimonials Management
        </h1>
        <button onclick="showCreateForm()" class="btn-primary"
          >+ Add Testimonial</button
        >
      </div>

      {
        error && (
          <div style="background-color: rgba(235, 111, 146, 0.2); border: 1px solid var(--rp-love); color: var(--rp-love); padding: 12px; border-radius: 6px; margin-bottom: 16px;">
            Error loading testimonials: {error.message}
          </div>
        )
      }

      {
        testimonials && testimonials.length === 0 && (
          <div style="text-align: center; padding: 48px 0;">
            <div style="font-size: 48px; margin-bottom: 16px;">💬</div>
            <h3 style="margin: 8px 0; font-size: 18px;">No testimonials</h3>
            <p style="margin: 4px 0; font-size: 14px;" class="text-subtle">
              Get started by adding your first client testimonial.
            </p>
          </div>
        )
      }

      {
        testimonials && testimonials.length > 0 && (
          <div
            class="card-bg mb-4"
            style="border-radius: 8px; overflow: hidden;"
          >
            {testimonials.map((testimonial: any, index: number) => (
              <div
                style={`padding: 20px; ${index !== testimonials.length - 1 ? 'border-bottom: 1px solid var(--rp-overlay);' : ''}`}
              >
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                  <div style="flex: 1; display: flex; gap: 16px;">
                    <img
                      src={testimonial.image || '/favicon.svg'}
                      alt={testimonial.name}
                      style="width: 60px; height: 60px; border-radius: 50%; object-fit: cover; background-color: var(--rp-overlay);"
                    />
                    <div style="flex: 1;">
                      <h3 style="font-size: 18px; font-weight: 600; margin: 0 0 4px 0;">
                        {testimonial.name}
                      </h3>
                      <p
                        style="font-size: 14px; margin: 0 0 8px 0;"
                        class="text-subtle"
                      >
                        {testimonial.role} at {testimonial.company}
                      </p>
                      <div style="margin: 8px 0;">
                        <div class="star-rating">
                          {Array.from({ length: testimonial.rating })
                            .map(() => '★')
                            .join('')}
                          {Array.from({ length: 5 - testimonial.rating })
                            .map(() => '☆')
                            .join('')}
                        </div>
                      </div>
                      <blockquote style="font-size: 14px; margin: 8px 0; font-style: italic; color: var(--rp-subtle); border-left: 3px solid var(--rp-overlay); padding-left: 12px;">
                        "{testimonial.content}"
                      </blockquote>
                    </div>
                  </div>
                  <div style="display: flex; gap: 8px; margin-left: 16px;">
                    <button
                      onclick={`editTestimonial('${testimonial.id}')`}
                      class="btn-edit"
                    >
                      Edit
                    </button>
                    <button
                      onclick={`deleteTestimonial('${testimonial.id}')`}
                      class="btn-delete"
                    >
                      Delete
                    </button>
                  </div>
                </div>
              </div>
            ))}
          </div>
        )
      }
    </main>

    <div id="testimonialModal" class="modal hidden">
      <div class="modal-content">
        <h2
          id="modalTitle"
          style="font-size: 20px; font-weight: bold; margin: 0 0 16px 0;"
        >
          Add Testimonial
        </h2>
        <form id="testimonialForm">
          <input type="hidden" id="testimonialId" />

          <div style="margin-bottom: 16px;">
            <label
              style="display: block; font-size: 14px; font-weight: 500; margin-bottom: 4px;"
              >Name</label
            >
            <input type="text" id="name" required class="form-input" />
          </div>

          <div style="margin-bottom: 16px;">
            <label
              style="display: block; font-size: 14px; font-weight: 500; margin-bottom: 4px;"
              >Role</label
            >
            <input type="text" id="role" required class="form-input" />
          </div>

          <div style="margin-bottom: 16px;">
            <label
              style="display: block; font-size: 14px; font-weight: 500; margin-bottom: 4px;"
              >Company</label
            >
            <input type="text" id="company" required class="form-input" />
          </div>

          <div style="margin-bottom: 16px;">
            <label
              style="display: block; font-size: 14px; font-weight: 500; margin-bottom: 4px;"
              >Image URL</label
            >
            <input
              type="url"
              id="image"
              class="form-input"
              placeholder="/favicon.svg"
            />
          </div>

          <div style="margin-bottom: 16px;">
            <label
              style="display: block; font-size: 14px; font-weight: 500; margin-bottom: 4px;"
              >Rating</label
            >
            <select id="rating" required class="form-input">
              <option value="5">5 Stars</option>
              <option value="4">4 Stars</option>
              <option value="3">3 Stars</option>
              <option value="2">2 Stars</option>
              <option value="1">1 Star</option>
            </select>
          </div>

          <div style="margin-bottom: 24px;">
            <label
              style="display: block; font-size: 14px; font-weight: 500; margin-bottom: 4px;"
              >Testimonial Content</label
            >
            <textarea
              id="content"
              rows="4"
              required
              class="form-input"
              placeholder="Write the client's testimonial here..."></textarea>
          </div>

          <div style="display: flex; justify-content: flex-end; gap: 12px;">
            <button
              type="button"
              onclick="closeModal()"
              style="background: none; border: 1px solid var(--rp-muted); color: var(--rp-subtle); padding: 8px 16px; border-radius: 4px; cursor: pointer;"
              >Cancel</button
            >
            <button type="submit" class="btn-primary">Save Testimonial</button>
          </div>
        </form>
      </div>
    </div>

    <script is:inline>
      let currentTestimonialId = null;

      function showCreateForm() {
        const modalTitle = document.getElementById('modalTitle');
        const testimonialForm = document.getElementById('testimonialForm');
        const testimonialId = document.getElementById('testimonialId');
        const testimonialModal = document.getElementById('testimonialModal');

        if (modalTitle) modalTitle.textContent = 'Add Testimonial';
        if (testimonialForm) testimonialForm.reset();
        if (testimonialId) testimonialId.value = '';
        currentTestimonialId = null;
        if (testimonialModal) testimonialModal.classList.remove('hidden');
      }

      async function editTestimonial(id) {
        try {
          const response = await fetch(`/api/testimonial/${id}`);
          const testimonial = await response.json();

          const modalTitle = document.getElementById('modalTitle');
          const testimonialId = document.getElementById('testimonialId');
          const name = document.getElementById('name');
          const role = document.getElementById('role');
          const company = document.getElementById('company');
          const image = document.getElementById('image');
          const rating = document.getElementById('rating');
          const content = document.getElementById('content');
          const testimonialModal = document.getElementById('testimonialModal');

          modalTitle.textContent = 'Edit Testimonial';
          testimonialId.value = testimonial.id;
          name.value = testimonial.name;
          role.value = testimonial.role;
          company.value = testimonial.company;
          image.value = testimonial.image || '';
          rating.value = testimonial.rating;
          content.value = testimonial.content;

          currentTestimonialId = id;
          testimonialModal.classList.remove('hidden');
        } catch (error) {
          alert(
            'Error loading testimonial: ' + (error?.message || 'Unknown error')
          );
        }
      }

      async function deleteTestimonial(id) {
        if (!confirm('Are you sure you want to delete this testimonial?')) {
          return;
        }

        try {
          const response = await fetch(`/api/testimonial/${id}`, {
            method: 'DELETE',
          });

          if (response.ok) {
            window.location.reload();
          } else {
            const error = await response.json();
            alert('Error deleting testimonial: ' + error.error);
          }
        } catch (error) {
          alert(
            'Error deleting testimonial: ' + (error?.message || 'Unknown error')
          );
        }
      }

      function closeModal() {
        const testimonialModal = document.getElementById('testimonialModal');
        if (testimonialModal) testimonialModal.classList.add('hidden');
      }

      const testimonialForm = document.getElementById('testimonialForm');
      if (testimonialForm) {
        testimonialForm.addEventListener('submit', async e => {
          e.preventDefault();

          const name = document.getElementById('name');
          const role = document.getElementById('role');
          const company = document.getElementById('company');
          const image = document.getElementById('image');
          const rating = document.getElementById('rating');
          const content = document.getElementById('content');

          const formData = {
            name: name.value,
            role: role.value,
            company: company.value,
            image: image.value || '/favicon.svg',
            rating: parseInt(rating.value),
            content: content.value,
          };

          try {
            const url = currentTestimonialId
              ? `/api/testimonial/${currentTestimonialId}`
              : '/api/testimonial/';
            const method = currentTestimonialId ? 'PUT' : 'POST';

            const response = await fetch(url, {
              method: method,
              headers: {
                'Content-Type': 'application/json',
              },
              body: JSON.stringify(formData),
            });

            if (response.ok) {
              window.location.reload();
            } else {
              const error = await response.json();
              alert('Error saving testimonial: ' + error.error);
            }
          } catch (error) {
            alert(
              'Error saving testimonial: ' + (error?.message || 'Unknown error')
            );
          }
        });
      }

      const testimonialModal = document.getElementById('testimonialModal');
      if (testimonialModal) {
        testimonialModal.addEventListener('click', e => {
          if (e.target === e.currentTarget) {
            closeModal();
          }
        });
      }
    </script>
  </body>
</html>

