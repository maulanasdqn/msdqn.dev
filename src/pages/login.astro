---
const { cookies, redirect, url } = Astro;

const session = cookies.get('session');

if (session) {
  return redirect('/cms');
}

const message = url.searchParams.get('message');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Login - CMS</title>
    <meta
      name="description"
      content="Login to access the content management system"
    />

    <style>
      :root {
        --mono-bg: #0a0a0a;
        --mono-surface: #111111;
        --mono-raised: #262626;
        --mono-muted: #737373;
        --mono-subtle: #a3a3a3;
        --mono-text: #fafafa;
        --mono-accent: #fafafa;
      }

      body {
        background-color: var(--mono-bg);
        color: var(--mono-text);
        font-family:
          system-ui,
          -apple-system,
          sans-serif;
      }

      .login-container {
        background-color: var(--mono-surface);
        border: 1px solid var(--mono-raised);
        border-radius: 12px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
      }

      .form-input {
        background-color: var(--mono-raised);
        border: 1px solid var(--mono-muted);
        color: var(--mono-text);
        border-radius: 6px;
        padding: 12px 16px;
        width: 100%;
        box-sizing: border-box;
        transition: all 0.2s;
      }

      .form-input:focus {
        outline: none;
        border-color: var(--mono-accent);
        box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.08);
      }

      .form-input::placeholder {
        color: var(--mono-muted);
      }

      .btn-primary {
        background-color: var(--mono-accent);
        color: var(--mono-bg);
        border: none;
        border-radius: 6px;
        padding: 12px 24px;
        width: 100%;
        cursor: pointer;
        font-weight: 600;
        transition: all 0.2s;
      }

      .btn-primary:hover {
        background-color: var(--mono-accent);
        color: var(--mono-bg);
      }

      .btn-primary:focus {
        outline: none;
        box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.08);
      }

      .success-message {
        background-color: rgba(255, 255, 255, 0.08);
        border: 1px solid var(--mono-accent);
        color: var(--mono-accent);
        border-radius: 6px;
        padding: 12px 16px;
      }

      .logo-text {
        color: var(--mono-text);
        font-size: 2rem;
        font-weight: bold;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
      }

      .subtitle {
        color: var(--mono-subtle);
      }

      .form-group {
        margin-bottom: 16px;
      }

      .form-label {
        display: block;
        color: var(--mono-text);
        font-size: 14px;
        font-weight: 500;
        margin-bottom: 6px;
      }

      .btn-primary:disabled {
        opacity: 0.6;
        cursor: not-allowed;
      }

      .login-container {
        animation: fadeIn 0.5s ease-out;
      }

      @keyframes fadeIn {
        from {
          opacity: 0;
          transform: translateY(10px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .form-input:focus + .form-label,
      .form-input:not(:placeholder-shown) + .form-label {
        color: var(--mono-accent);
      }
    </style>
  </head>
  <body class="min-h-screen flex items-center justify-center py-12 px-4">
    <div class="login-container max-w-md w-full p-8">
      <div class="text-center mb-8">
        <div class="logo-text">Admin Login</div>
        <p class="subtitle text-center">
          Personal website content management system
        </p>
      </div>

      {message && <div class="success-message mb-6">{message}</div>}

      <form action="/api/auth/signin" method="post">
        <div class="form-group">
          <label for="email" class="form-label">Email address</label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            required
            class="form-input"
            placeholder="Enter your email"
          />
        </div>

        <div class="form-group">
          <label for="password" class="form-label">Password</label>
          <input
            id="password"
            name="password"
            type="password"
            autocomplete="current-password"
            required
            class="form-input"
            placeholder="Enter your password"
          />
        </div>

        <button type="submit" class="btn-primary" id="submitBtn">
          Sign in
        </button>
      </form>
    </div>

    <script is:inline>
      document.addEventListener('DOMContentLoaded', function () {
        const form = document.querySelector('form');
        const submitBtn = document.getElementById('submitBtn');
        const originalText = submitBtn.textContent;

        form.addEventListener('submit', function () {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Signing in...';

          // Re-enable after 10 seconds in case of network issues
          setTimeout(function () {
            submitBtn.disabled = false;
            submitBtn.textContent = originalText;
          }, 10000);
        });

        // Auto-focus first input
        const emailInput = document.getElementById('email');
        if (emailInput) {
          emailInput.focus();
        }
      });
    </script>
  </body>
</html>
