---
import AccessibilityImprovements from '@/components/ui/accessibility-improvements.astro';
import CaseStudiesSection from '@/components/ui/case-studies-section.astro';
import CriticalCSS from '@/components/ui/critical-css.astro';
import CriticalResources from '@/components/ui/critical-resources.astro';
import ExperienceItem from '@/components/ui/experience-item.astro';
import FooterSection from '@/components/ui/footer-section.astro';
import HeroSection from '@/components/ui/hero-section.astro';
import LighthouseOptimizations from '@/components/ui/lighthouse-optimizations.astro';
import NavigationBar from '@/components/ui/navigation-bar.astro';
import PerformanceOptimizations from '@/components/ui/performance-optimizations.astro';
import ProjectCard from '@/components/ui/project-card.astro';
import SectionHeading from '@/components/ui/section-heading.astro';
import TestimonialsSection from '@/components/ui/testimonials-section.astro';

import { decodeRows, getDb, getSingleton, listRows, tables } from '@/libs/d1';

const db = getDb(Astro.locals);

let homeData = null;
let aboutData = null;
let experiences: Record<string, any>[] = [];
let projects: Record<string, any>[] = [];
let caseStudies: Record<string, any>[] = [];
let testimonials: Record<string, any>[] = [];

try {
  const [
    home,
    about,
    experienceRows,
    projectRows,
    caseStudyRows,
    testimonialRows,
  ] = await Promise.all([
    getSingleton(db, 'home_content'),
    getSingleton(db, 'about_content'),
    listRows(db, 'experiences'),
    listRows(db, 'projects'),
    db
      .prepare(
        'SELECT * FROM case_studies WHERE is_featured = 1 ORDER BY created_at DESC'
      )
      .all(),
    listRows(db, 'testimonials'),
  ]);
  homeData = home;
  aboutData = about;
  experiences = experienceRows;
  projects = projectRows;
  caseStudies = decodeRows(tables.case_studies, caseStudyRows.results);
  testimonials = testimonialRows;
} catch {
  experiences = [];
  projects = [];
}

const skills = [
  {
    title: 'Languages',
    items: ['Rust', 'TypeScript', 'JavaScript', 'SQL', 'PHP'],
  },
  {
    title: 'Backend',
    items: ['Axum', 'Tokio', 'tonic (gRPC)', 'sqlx', 'Hono', 'oRPC', 'Laravel'],
  },
  {
    title: 'Frontend',
    items: [
      'React',
      'TanStack Start/Router/Query',
      'Next.js',
      'Vue',
      'TailwindCSS',
      'shadcn/ui',
    ],
  },
  {
    title: 'Data & Messaging',
    items: [
      'PostgreSQL',
      'Redis',
      'RabbitMQ',
      'BullMQ',
      'BigQuery',
      'Drizzle ORM',
    ],
  },
  {
    title: 'Infra & QA',
    items: [
      'Docker',
      'Kubernetes',
      'GitHub Actions',
      'DigitalOcean',
      'Vercel',
      'Cloudflare Workers',
      'Vitest',
      'Playwright',
    ],
  },
  {
    title: 'Web Automation',
    items: [
      'Chromium/CDP',
      'Anti-bot bypass (Cloudflare, PerimeterX, Kasada)',
      'Residential proxies',
    ],
  },
];

const contactLinks = [
  {
    label: 'Email',
    value: 'maulanasdqn@gmail.com',
    href: 'mailto:maulanasdqn@gmail.com',
  },
  { label: 'Phone', value: '+62 851-5608-5579', href: 'tel:+6285156085579' },
  {
    label: 'GitHub',
    value: 'github.com/maulanasdqn',
    href: 'https://github.com/maulanasdqn',
  },
  {
    label: 'LinkedIn',
    value: 'in/maulana-sodiqin',
    href: 'https://www.linkedin.com/in/maulana-sodiqin/',
  },
];

const formatMonth = (value?: string | null) => {
  if (!value) return '';
  const match = /^(\d{4})-(\d{2})/.exec(value);
  if (!match) return value;
  const month = new Date(
    Date.UTC(2000, Number(match[2]) - 1, 1)
  ).toLocaleString('en-US', { month: 'short', timeZone: 'UTC' });
  return `${month} ${match[1]}`;
};

const sectionOrder = [
  'about',
  'experience',
  'projects',
  ...(caseStudies.length > 0 ? ['case-studies'] : []),
  ...(testimonials.length > 0 ? ['testimonials'] : []),
  'contact',
];
const num = (key: string) =>
  String(sectionOrder.indexOf(key) + 1).padStart(2, '0');

const siteUrl = 'https://msdqn.dev';
const siteName = 'Maulana Sodiqin';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <CriticalResources critical={true} />

    <title>
      {homeData?.title || 'Maulana Sodiqin — Software Engineer'}
    </title>

    <meta
      name="description"
      content={homeData?.meta_description ||
        'Senior software engineer with 7 years of experience building production web platforms in Rust and TypeScript. Based in Bandung, Indonesia, open to remote and relocation.'}
    />

    <meta
      name="keywords"
      content={homeData?.meta_keywords ||
        'hire fullstack developer, react developer for hire, typescript expert, rust developer, frontend developer job, software engineer hire, maulana sodiqin, fullstack developer malang, remote developer indonesia, react typescript developer, senior frontend developer, javascript developer hire, software engineer portfolio, web developer for hire, full stack engineer, react specialist, modern web developer'}
    />

    <meta name="author" content="Maulana Sodiqin" />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <meta name="language" content="English" />
    <meta name="revisit-after" content="7 days" />
    <meta name="classification" content="Professional Portfolio" />
    <meta name="rating" content="General" />
    <meta name="distribution" content="Global" />
    <meta name="theme-color" content="#0a0a0a" />

    <link rel="canonical" href={siteUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />

    <meta property="og:title" content="Maulana Sodiqin — Software Engineer" />
    <meta
      property="og:description"
      content="Senior software engineer with 7 years of experience building production web platforms in Rust and TypeScript. Based in Bandung, Indonesia, open to remote and relocation."
    />
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={`${siteUrl}/og-image.png`} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Maulana Sodiqin - Senior Software Engineer"
    />
    <meta property="og:locale" content="en_US" />
    <meta property="profile:first_name" content="Maulana" />
    <meta property="profile:last_name" content="Sodiqin" />
    <meta property="profile:username" content="maulanasdqn" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Maulana Sodiqin — Software Engineer" />
    <meta
      name="twitter:description"
      content="Senior software engineer with 7 years of experience building production web platforms in Rust and TypeScript. Based in Bandung, Indonesia, open to remote and relocation."
    />
    <meta name="twitter:image" content={`${siteUrl}/og-image.png`} />
    <meta
      name="twitter:image:alt"
      content="Maulana Sodiqin - Senior Software Engineer"
    />
    <meta name="twitter:creator" content="@maulanasdqn" />
    <meta name="twitter:site" content="@maulanasdqn" />

    <meta name="linkedin:owner" content="maulana-sodiqin" />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: 'Maulana Sodiqin',
        givenName: 'Maulana',
        familyName: 'Sodiqin',
        url: siteUrl,
        image: `${siteUrl}/og-image.png`,
        sameAs: [
          'https://www.linkedin.com/in/maulana-sodiqin/',
          'https://github.com/maulanasdqn',
          'mailto:maulanasdqn@gmail.com',
        ],
        jobTitle: 'Senior Software Engineer',
        description:
          'Senior software engineer with 7 years of experience building production web platforms in Rust and TypeScript. Sole engineer behind a rebuilt web scraping engine (400 jobs/s sustained, anti-bot unblocking), and delivers full-stack client platforms end to end.',
        knowsAbout: [
          'Rust',
          'TypeScript',
          'React',
          'Web Scraping',
          'Browser Automation',
          'Browser Fingerprinting & Anti-Bot Evasion',
          'Chromium Internals',
          'Cloudflare Workers',
          'Edge Computing',
          'WebAssembly',
          'AI Agents',
          'Model Context Protocol (MCP)',
          'LLM Tooling',
          'gRPC Microservices',
          'Next.js',
          'Nx Monorepo',
          'Micro Frontends',
          'Nix & NixOS',
          'Infrastructure as Code',
          'Full Stack Development',
        ],
        alumniOf: {
          '@type': 'EducationalOrganization',
          name: 'Universitas Islam Nusantara',
        },
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Bandung',
          addressRegion: 'West Java',
          addressCountry: 'Indonesia',
        },
        email: 'maulanasdqn@gmail.com',
        telephone: '+6285156085579',
        worksFor: {
          '@type': 'Organization',
          name: 'PT Pena Teknologi Indonesia (MrScraper)',
        },
        hasOccupation: {
          '@type': 'Occupation',
          name: 'Senior Software Engineer',
          occupationLocation: {
            '@type': 'Place',
            name: 'Remote/Bandung, Indonesia',
          },
          skills: [
            'React Development',
            'TypeScript Programming',
            'JavaScript Development',
            'Rust Programming',
            'Frontend Architecture',
            'Backend Development',
            'Full Stack Development',
            'Web Application Development',
            'Software Engineering',
            'UI/UX Implementation',
          ],
        },
      })}
    />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: siteName,
        url: siteUrl,
        description:
          'Portfolio of Maulana Sodiqin, senior software engineer building production web platforms in Rust and TypeScript.',
        author: {
          '@type': 'Person',
          name: 'Maulana Sodiqin',
        },
        inLanguage: 'en-US',
      })}
    />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'ProfessionalService',
        name: 'Maulana Sodiqin - Fullstack Development Services',
        description:
          'Professional fullstack development services specializing in React, TypeScript, and Rust applications',
        provider: {
          '@type': 'Person',
          name: 'Maulana Sodiqin',
        },
        areaServed: 'Worldwide',
        availableLanguage: 'English',
        priceRange: '$$',
        serviceType: [
          'Fullstack Development',
          'Frontend Development',
          'Backend Development',
          'Web Application Development',
          'React Development',
          'TypeScript Development',
          'Rust Development',
        ],
      })}
    />

    <LighthouseOptimizations />
    <CriticalCSS />
    <PerformanceOptimizations />
  </head>
  <body class="bg-mono-bg text-mono-text antialiased">
    <AccessibilityImprovements />
    <NavigationBar />

    <main role="main" id="main-content">
      <section id="home" aria-label="Introduction">
        <HeroSection
          ctaText={homeData?.hero_cta_text || "Let's talk"}
          ctaLink={homeData?.hero_cta_link || '#contact'}
        />
      </section>

      <section
        id="about"
        class="max-w-5xl mx-auto px-6 sm:px-8 py-16 sm:py-20"
        aria-labelledby="about-heading"
      >
        <SectionHeading
          number={num('about')}
          title="About"
          id="about-heading"
        />

        <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
          <div class="md:col-start-4 md:col-span-9 space-y-6">
            <p
              class="font-medium text-2xl sm:text-[1.75rem] leading-snug text-mono-text"
            >
              {
                aboutData?.description_1 ||
                  'I am proficient in modular UI architecture, design systems, test-driven development, and modern state management with React Query and Jotai. I have extensive experience working with micro frontend structures and NX monorepos to support large-scale applications.'
              }
            </p>
            <p class="text-lg leading-relaxed text-mono-subtle">
              {
                aboutData?.description_2 ||
                  'Currently expanding my full-stack skills with Rust and Axum to gain deeper backend architecture understanding, while maintaining my expertise in modern frontend technologies.'
              }
            </p>
          </div>
        </div>

        <div
          class="mt-16 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-10 gap-y-12"
        >
          {
            skills.map(group => (
              <div>
                <h3 class="text-xs font-medium uppercase tracking-[0.14em] text-mono-muted mb-5">
                  {group.title}
                </h3>
                <p class="leading-relaxed text-mono-subtle">
                  {group.items.join(', ')}
                </p>
              </div>
            ))
          }
        </div>
      </section>

      <section
        id="experience"
        class="max-w-5xl mx-auto px-6 sm:px-8 py-16 sm:py-20"
        aria-labelledby="experience-heading"
      >
        <SectionHeading
          number={num('experience')}
          title="Experience"
          id="experience-heading"
        />
        <div>
          {
            experiences.map(experience => (
              <ExperienceItem
                title={experience.title}
                company={experience.company}
                duration={`${formatMonth(experience.start_date)} — ${experience.end_date ? formatMonth(experience.end_date) : 'Present'}`}
                employmentType={experience.location || undefined}
                description={experience.description || ''}
                responsibilities={experience.responsibilities || []}
              />
            ))
          }
        </div>
      </section>

      <section
        id="projects"
        class="max-w-5xl mx-auto px-6 sm:px-8 py-16 sm:py-20"
        aria-labelledby="projects-heading"
      >
        <SectionHeading
          number={num('projects')}
          title="Selected Projects"
          id="projects-heading"
        />
        <div>
          {
            projects.map(project => (
              <ProjectCard
                title={project.title}
                description={project.description || ''}
                technologies={project.technologies || []}
                period={
                  project.start_date
                    ? `${formatMonth(project.start_date)} — ${project.end_date ? formatMonth(project.end_date) : 'Present'}`
                    : undefined
                }
                category={project.category || undefined}
                featured={Boolean(project.is_featured)}
                demoLink={project.live_url || undefined}
                githubLink={project.github_url || undefined}
              />
            ))
          }
        </div>
      </section>

      {
        caseStudies.length > 0 && (
          <CaseStudiesSection
            number={num('case-studies')}
            caseStudies={caseStudies}
          />
        )
      }

      {
        testimonials.length > 0 && (
          <TestimonialsSection
            number={num('testimonials')}
            testimonials={testimonials as any}
          />
        )
      }

      <section
        id="contact"
        class="max-w-5xl mx-auto px-6 sm:px-8 py-16 sm:py-20"
        aria-labelledby="contact-heading"
      >
        <SectionHeading
          number={num('contact')}
          title="Contact"
          id="contact-heading"
        />

        <div class="grid grid-cols-1 md:grid-cols-12 gap-12">
          <div class="md:col-span-7">
            <p
              class="font-medium text-4xl sm:text-5xl leading-tight tracking-tight text-mono-text"
            >
              Let&rsquo;s build something good together.
            </p>
            <p class="mt-6 max-w-md text-mono-subtle leading-relaxed">
              Open to full-time roles and contract work. Based in Bandung,
              Indonesia, and open to remote and relocation.
            </p>
            <a
              href="mailto:maulanasdqn@gmail.com"
              class="mt-10 inline-flex items-center gap-2 bg-mono-text text-mono-bg px-5 py-3 text-sm hover:bg-mono-subtle transition-colors"
            >
              Write to me <span aria-hidden="true">&rarr;</span>
            </a>
          </div>

          <dl class="md:col-span-5 md:pt-2">
            {
              contactLinks.map(link => (
                <div class="flex items-baseline justify-between gap-4 py-4 border-b border-mono-line first:border-t">
                  <dt class="text-xs font-medium uppercase tracking-[0.14em] text-mono-muted">
                    {link.label}
                  </dt>
                  <dd>
                    <a
                      href={link.href}
                      class="text-mono-text hover:text-mono-subtle transition-colors"
                      {...(link.href.startsWith('http')
                        ? { target: '_blank', rel: 'noopener noreferrer' }
                        : {})}
                    >
                      {link.value}
                    </a>
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>
      </section>
    </main>

    <FooterSection />
  </body>
</html>
