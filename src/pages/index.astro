---
import AccessibilityImprovements from '@/components/ui/accessibility-improvements.astro';
import AnalyticsPartytown from '@/components/ui/analytics-partytown.astro';
import AnimationWrapper from '@/components/ui/animation-wrapper.astro';
import CaseStudiesSection from '@/components/ui/case-studies-section.astro';
import CriticalCSS from '@/components/ui/critical-css.astro';
import CriticalResources from '@/components/ui/critical-resources.astro';
import ExperienceItem from '@/components/ui/experience-item.astro';
import FooterSection from '@/components/ui/footer-section.astro';
import HeroSection from '@/components/ui/hero-section.astro';
import LighthouseOptimizations from '@/components/ui/lighthouse-optimizations.astro';
import NavigationBar from '@/components/ui/navigation-bar.astro';
import PerformanceOptimizations from '@/components/ui/performance-optimizations.astro';
import ProjectCard from '@/components/ui/project-card.astro';
import TestimonialsSection from '@/components/ui/testimonials-section.astro';

const homeResponse = await fetch(`${Astro.url.origin}/api/home`);
const homeData = homeResponse.ok ? await homeResponse.json() : null;

const aboutResponse = await fetch(`${Astro.url.origin}/api/about`);
const aboutData = aboutResponse.ok ? await aboutResponse.json() : null;

const experienceResponse = await fetch(`${Astro.url.origin}/api/experience`);
const experiences = experienceResponse.ok
  ? await experienceResponse.json()
  : [];

const projectsResponse = await fetch(`${Astro.url.origin}/api/project`);
const projects = projectsResponse.ok ? await projectsResponse.json() : [];

const siteUrl = 'https://msdqn.dev';
const siteName = 'Maulana Sodiqin - Fullstack Developer';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <CriticalResources critical={true} />
    <AnalyticsPartytown />

    <title>
      {
        homeData?.title ||
          'Hire Maulana Sodiqin - Senior Fullstack Developer | React, TypeScript, Rust Expert'
      }
    </title>

    <meta
      name="description"
      content={homeData?.meta_description ||
        'Hire experienced Fullstack Developer Maulana Sodiqin. 5+ years React, TypeScript, Rust expertise. Available for full-time positions, freelance projects. Based in Malang, Indonesia. Open to remote work.'}
    />

    <meta
      name="keywords"
      content={homeData?.meta_keywords ||
        'hire fullstack developer, react developer for hire, typescript expert, rust developer, frontend developer job, software engineer hire, maulana sodiqin, fullstack developer malang, remote developer indonesia, react typescript developer, senior frontend developer, javascript developer hire, software engineer portfolio, web developer for hire, full stack engineer, react specialist, modern web developer'}
    />

    <meta name="author" content="Maulana Sodiqin" />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <meta name="language" content="English" />
    <meta name="revisit-after" content="7 days" />
    <meta name="classification" content="Professional Portfolio" />
    <meta name="rating" content="General" />
    <meta name="distribution" content="Global" />
    <meta name="theme-color" content="#191724" />

    <link rel="canonical" href={siteUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />

    <meta
      property="og:title"
      content="Hire Maulana Sodiqin - Senior Fullstack Developer | React, TypeScript, Rust Expert"
    />
    <meta
      property="og:description"
      content="Experienced Fullstack Developer available for hire. 5+ years expertise in React, TypeScript, Rust. Open to full-time positions and freelance projects."
    />
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={`${siteUrl}/favicon.svg`} />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta
      property="og:image:alt"
      content="Maulana Sodiqin - Fullstack Developer Portfolio"
    />
    <meta property="og:locale" content="en_US" />
    <meta property="profile:first_name" content="Maulana" />
    <meta property="profile:last_name" content="Sodiqin" />
    <meta property="profile:username" content="maulanasdqn" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content="Hire Maulana Sodiqin - Senior Fullstack Developer"
    />
    <meta
      name="twitter:description"
      content="Experienced Fullstack Developer available for hire. 5+ years expertise in React, TypeScript, Rust."
    />
    <meta name="twitter:image" content={`${siteUrl}/favicon.svg`} />
    <meta
      name="twitter:image:alt"
      content="Maulana Sodiqin - Fullstack Developer Portfolio"
    />
    <meta name="twitter:creator" content="@maulanasdqn" />
    <meta name="twitter:site" content="@maulanasdqn" />

    <meta name="linkedin:owner" content="maulana-sodiqin" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: 'Maulana Sodiqin',
        givenName: 'Maulana',
        familyName: 'Sodiqin',
        url: siteUrl,
        image: `${siteUrl}/favicon.svg`,
        sameAs: [
          'https://www.linkedin.com/in/maulana-sodiqin/',
          'https://github.com/maulanasdqn',
          'mailto:maulanasdqn@gmail.com',
        ],
        jobTitle: 'Senior Fullstack Developer',
        description:
          'Experienced Fullstack Developer with 5+ years of expertise in React, TypeScript, and Rust. Available for full-time positions and freelance projects.',
        knowsAbout: [
          'React',
          'TypeScript',
          'JavaScript',
          'Rust',
          'Next.js',
          'Node.js',
          'Frontend Development',
          'Backend Development',
          'Full Stack Development',
          'Web Development',
          'Software Engineering',
          'UI/UX Development',
          'Modern Web Technologies',
        ],
        alumniOf: {
          '@type': 'EducationalOrganization',
          name: 'Education Institution',
        },
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Malang',
          addressRegion: 'East Java',
          addressCountry: 'Indonesia',
        },
        email: 'maulanasdqn@gmail.com',
        telephone: '+6285156085579',
        worksFor: {
          '@type': 'Organization',
          name: 'Freelance Developer',
        },
        hasOccupation: {
          '@type': 'Occupation',
          name: 'Fullstack Developer',
          occupationLocation: {
            '@type': 'Place',
            name: 'Remote/Malang, Indonesia',
          },
          skills: [
            'React Development',
            'TypeScript Programming',
            'JavaScript Development',
            'Rust Programming',
            'Frontend Architecture',
            'Backend Development',
            'Full Stack Development',
            'Web Application Development',
            'Software Engineering',
            'UI/UX Implementation',
          ],
        },
        seeks: {
          '@type': 'JobPosting',
          title: 'Senior Fullstack Developer Position',
          description:
            'Seeking full-time or freelance opportunities as a Senior Fullstack Developer',
          employmentType: ['FULL_TIME', 'CONTRACTOR', 'TEMPORARY'],
          experienceRequirements: '5+ years',
          skills: [
            'React',
            'TypeScript',
            'Rust',
            'JavaScript',
            'Node.js',
            'Next.js',
          ],
        },
      })}
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: siteName,
        url: siteUrl,
        description:
          'Professional portfolio of Maulana Sodiqin, Senior Fullstack Developer specializing in React, TypeScript, and Rust development.',
        author: {
          '@type': 'Person',
          name: 'Maulana Sodiqin',
        },
        inLanguage: 'en-US',
        potentialAction: {
          '@type': 'SearchAction',
          target: {
            '@type': 'EntryPoint',
            urlTemplate: `${siteUrl}/?q={search_term_string}`,
          },
          'query-input': 'required name=search_term_string',
        },
      })}
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'ProfessionalService',
        name: 'Maulana Sodiqin - Fullstack Development Services',
        description:
          'Professional fullstack development services specializing in React, TypeScript, and Rust applications',
        provider: {
          '@type': 'Person',
          name: 'Maulana Sodiqin',
        },
        areaServed: 'Worldwide',
        availableLanguage: 'English',
        priceRange: '$$',
        serviceType: [
          'Fullstack Development',
          'Frontend Development',
          'Backend Development',
          'Web Application Development',
          'React Development',
          'TypeScript Development',
          'Rust Development',
        ],
      })}
    />

    <LighthouseOptimizations />
    <CriticalCSS />
    <PerformanceOptimizations />

    <style>
      .scrolling-section {
        opacity: 1;
      }

      .scrolling-section .card {
        opacity: 1;
      }
    </style>
  </head>
  <body class="bg-rose-pine-base text-rose-pine-text">
    <AccessibilityImprovements />
    <NavigationBar />

    <main>
      <section id="home" class="scrolling-section">
        <HeroSection
          ctaText={homeData?.hero_cta_text || "Let's talk"}
          ctaLink={homeData?.hero_cta_link || '#contact'}
        />
      </section>

      <section
        id="about"
        class="scrolling-section py-16 px-6 bg-rose-pine-surface"
      >
        <div class="max-w-4xl mx-auto">
          <AnimationWrapper animation="fade-in" delay={0}>
            <h2 class="text-3xl font-bold mb-8 text-rose-pine-text text-center">
              About Me
            </h2>
          </AnimationWrapper>

          <AnimationWrapper animation="scale-up" delay={200}>
            <div
              class="bg-rose-pine-overlay/50 backdrop-blur-sm p-8 rounded-xl border border-rose-pine-highlight-med"
            >
              <p class="text-rose-pine-subtle text-lg leading-relaxed mb-6">
                {
                  aboutData?.description_1 ||
                    'I am proficient in modular UI architecture, design systems, test-driven development, and modern state management with React Query and Jotai. I have extensive experience working with micro frontend structures and NX monorepos to support large-scale applications.'
                }
              </p>
              <p class="text-rose-pine-subtle text-lg leading-relaxed">
                {
                  aboutData?.description_2 ||
                    'Currently expanding my full-stack skills with Rust and Axum to gain deeper backend architecture understanding, while maintaining my expertise in modern frontend technologies.'
                }
              </p>
            </div>
          </AnimationWrapper>

          <div class="mt-16">
            <AnimationWrapper animation="fade-in" delay={400}>
              <h3
                class="text-2xl font-bold mb-8 text-rose-pine-text text-center"
              >
                Technical Skills
              </h3>
            </AnimationWrapper>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {
                [
                  {
                    title: 'Frontend Development',
                    color: 'iris',
                    skills: [
                      'ReactJS, NextJS, TypeScript',
                      'JavaScript (ES6+)',
                      'TailwindCSS, Shadcn, Ant Design',
                      'HTML/CSS, Responsive Design',
                    ],
                  },
                  {
                    title: 'State Management',
                    color: 'love',
                    skills: [
                      'Tanstack React Query',
                      'Jotai, Zustand, Recoil',
                      'Redux',
                    ],
                  },
                  {
                    title: 'Testing & Quality',
                    color: 'foam',
                    skills: [
                      'React Testing Library',
                      'Vitest, Jest, MSW',
                      'Test-Driven Development',
                    ],
                  },
                  {
                    title: 'Frontend Architecture',
                    color: 'pine',
                    skills: [
                      'NX Monorepo',
                      'Module Federation',
                      'Micro Frontend',
                    ],
                  },
                  {
                    title: 'Backend & Database',
                    color: 'gold',
                    skills: [
                      'Rust, Axum, SurrealDB',
                      'PostgreSQL',
                      'HonoJS, NestJS, ExpressJS',
                      'Drizzle, Prisma, TypeORM',
                    ],
                  },
                  {
                    title: 'UI Tooling & Design',
                    color: 'rose',
                    skills: [
                      'Storybook, Design Systems',
                      'Component-Driven Development',
                      'Performance Optimization',
                      'Accessibility, Cross-Browser',
                    ],
                  },
                ].map((skillSet, index) => (
                  <AnimationWrapper
                    animation="fade-up"
                    delay={600 + index * 100}
                  >
                    <div
                      class={`card bg-rose-pine-surface/50 backdrop-blur-sm p-6 rounded-xl border border-rose-pine-highlight-med`}
                    >
                      <div
                        class={`w-12 h-12 bg-rose-pine-${skillSet.color}/20 rounded-lg flex items-center justify-center mb-4`}
                      >
                        <svg
                          class={`w-6 h-6 text-rose-pine-${skillSet.color}`}
                          fill="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path d="M12 0l3.09 6.26L22 7.27l-5 4.87 1.18 6.88L12 15.77l-6.18 3.25L7 12.14 2 7.27l6.91-1.01L12 0z" />
                        </svg>
                      </div>
                      <h4 class="text-xl font-semibold mb-3 text-rose-pine-text">
                        {skillSet.title}
                      </h4>
                      <ul class="text-rose-pine-subtle space-y-1 text-sm">
                        {skillSet.skills.map(skill => (
                          <li>• {skill}</li>
                        ))}
                      </ul>
                    </div>
                  </AnimationWrapper>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <section
        id="experience"
        class="scrolling-section py-16 bg-rose-pine-base"
      >
        <div class="max-w-4xl mx-auto px-6">
          <AnimationWrapper animation="fade-in" delay={0}>
            <div class="text-center mb-16">
              <h2 class="text-4xl font-bold text-rose-pine-text mb-6">
                Experience & Skills
              </h2>
              <p
                class="text-lg text-rose-pine-subtle max-w-3xl mx-auto leading-relaxed mb-8"
              >
                Fullstack Developer with 5+ years building scalable web
                applications and leading development teams. Rust enthusiast
                exploring modern backend technologies.
              </p>
            </div>
          </AnimationWrapper>

          <div class="mb-16">
            <h3
              class="text-3xl font-bold text-rose-pine-text mb-12 flex items-center justify-center"
            >
              <svg
                class="w-8 h-8 mr-4 text-rose-pine-iris"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2-2v2m8 0V6a2 2 0 012 2v6a2 2 0 01-2 2H6a2 2 0 01-2-2V8a2 2 0 012-2V6"
                ></path>
              </svg>
              Work Experience
            </h3>

            <div class="space-y-6">
              {
                experiences &&
                  experiences.length > 0 &&
                  experiences.map((experience: any, index: number) => {
                    const animations = [
                      'slide-left',
                      'slide-right',
                      'rotate-in',
                    ] as const;
                    const animation = animations[index % animations.length];
                    const duration = `${experience.start_date}${experience.end_date ? ` - ${experience.end_date}` : ' - Present'}`;

                    return (
                      <AnimationWrapper
                        animation={animation}
                        distance={80}
                        delay={index * 200}
                      >
                        <ExperienceItem
                          title={experience.title}
                          company={experience.company}
                          duration={duration}
                          description={experience.description || ''}
                          responsibilities={experience.responsibilities || []}
                          type="work"
                        />
                      </AnimationWrapper>
                    );
                  })
              }
            </div>
          </div>

          <AnimationWrapper animation="zoom-in" delay={200}>
            <div class="mb-16">
              <div
                class="bg-rose-pine-surface/50 rounded-2xl p-8 border border-rose-pine-highlight-med"
              >
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 text-center">
                  <div>
                    <div class="text-3xl font-bold text-rose-pine-iris mb-2">
                      {aboutData?.stats_years || '5+'}
                    </div>
                    <div class="text-rose-pine-subtle font-medium">
                      Years Experience
                    </div>
                  </div>
                  <div>
                    <div class="text-3xl font-bold text-rose-pine-foam mb-2">
                      {aboutData?.stats_projects || '10+'}
                    </div>
                    <div class="text-rose-pine-subtle font-medium">
                      Projects Delivered
                    </div>
                  </div>
                  <div>
                    <div class="text-3xl font-bold text-rose-pine-rose mb-2">
                      {aboutData?.stats_users || '1000+'}
                    </div>
                    <div class="text-rose-pine-subtle font-medium">
                      Users Served
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </AnimationWrapper>
        </div>
      </section>

      <CaseStudiesSection />

      <TestimonialsSection />

      <section
        id="projects"
        class="scrolling-section py-16 px-6 bg-rose-pine-surface"
      >
        <div class="max-w-7xl mx-auto">
          <AnimationWrapper animation="fade-in" delay={0}>
            <div class="text-center mb-16">
              <h2 class="text-4xl font-bold mb-6 text-rose-pine-text">
                My Projects
              </h2>
              <p
                class="text-xl text-rose-pine-subtle max-w-3xl mx-auto leading-relaxed"
              >
                A showcase of innovative software solutions I've built over the
                years, from enterprise applications to specialized platforms
                serving thousands of users.
              </p>
            </div>
          </AnimationWrapper>

          <div
            class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-8"
            style="grid-auto-rows: 1fr;"
          >
            {
              projects &&
                projects.length > 0 &&
                projects.map((project: any, index: number) => {
                  const animations = [
                    'fade-up',
                    'scale-up',
                    'fade-right',
                    'zoom-in',
                    'flip-up',
                    'bounce-in',
                  ] as const;
                  const animation = animations[index % animations.length];

                  return (
                    <div class="h-full">
                      <AnimationWrapper
                        animation={animation}
                        distance={50}
                        class="h-full"
                      >
                        <ProjectCard
                          title={project.title}
                          description={project.description || ''}
                          technologies={project.technologies || []}
                          period={
                            project.start_date
                              ? `${project.start_date}${project.end_date ? ` – ${project.end_date}` : ''}`
                              : undefined
                          }
                          category={project.category || undefined}
                          demoLink={project.live_url || undefined}
                          githubLink={project.github_url || undefined}
                          highlights={project.is_featured ? ['Featured'] : []}
                        />
                      </AnimationWrapper>
                    </div>
                  );
                })
            }
          </div>
        </div>
      </section>

      <section id="contact" class="scrolling-section py-20 bg-rose-pine-base">
        <div class="max-w-6xl mx-auto px-6">
          <AnimationWrapper animation="fade-in" delay={0}>
            <div class="text-center mb-20">
              <h2 class="text-5xl font-bold text-rose-pine-text mb-8">
                Let's Connect
              </h2>
              <p
                class="text-xl text-rose-pine-subtle max-w-3xl mx-auto leading-relaxed"
              >
                I'm always interested in discussing new opportunities,
                collaborations, or just having a chat about technology. Feel
                free to reach out!
              </p>
            </div>
          </AnimationWrapper>

          <div class="max-w-4xl mx-auto">
            <AnimationWrapper animation="slide-up" delay={200}>
              <div class="space-y-8">
                <div>
                  <h3
                    class="text-3xl font-bold text-rose-pine-text mb-8 text-center"
                  >
                    Get In Touch
                  </h3>

                  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div
                      class="flex items-center p-6 bg-rose-pine-surface/50 backdrop-blur-sm rounded-2xl hover:bg-rose-pine-surface/70 transition-all duration-300 border border-rose-pine-highlight-med"
                    >
                      <div
                        class="w-12 h-12 bg-rose-pine-iris rounded-xl flex items-center justify-center mr-4"
                      >
                        <svg
                          class="w-6 h-6 text-rose-pine-base"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                          ></path>
                        </svg>
                      </div>
                      <div>
                        <h4 class="font-semibold text-rose-pine-text">Email</h4>
                        <a
                          href="mailto:maulanasdqn@gmail.com"
                          class="text-rose-pine-iris hover:text-rose-pine-iris/80 transition-colors"
                        >
                          maulanasdqn@gmail.com
                        </a>
                      </div>
                    </div>

                    <div
                      class="flex items-center p-6 bg-rose-pine-surface/50 backdrop-blur-sm rounded-2xl hover:bg-rose-pine-surface/70 transition-all duration-300 border border-rose-pine-highlight-med"
                    >
                      <div
                        class="w-12 h-12 bg-rose-pine-iris rounded-xl flex items-center justify-center mr-4"
                      >
                        <svg
                          class="w-6 h-6 text-rose-pine-base"
                          fill="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                          ></path>
                        </svg>
                      </div>
                      <div>
                        <h4 class="font-semibold text-rose-pine-text">
                          LinkedIn
                        </h4>
                        <a
                          href="https://www.linkedin.com/in/maulana-sodiqin/"
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-rose-pine-iris hover:text-rose-pine-iris/80 transition-colors"
                        >
                          linkedin.com/in/maulana-sodiqin
                        </a>
                      </div>
                    </div>

                    <div
                      class="flex items-center p-6 bg-rose-pine-surface/50 backdrop-blur-sm rounded-2xl hover:bg-rose-pine-surface/70 transition-all duration-300 border border-rose-pine-highlight-med"
                    >
                      <div
                        class="w-12 h-12 bg-rose-pine-muted rounded-xl flex items-center justify-center mr-4"
                      >
                        <svg
                          class="w-6 h-6 text-rose-pine-base"
                          fill="currentColor"
                          viewBox="0 0 24 24"
