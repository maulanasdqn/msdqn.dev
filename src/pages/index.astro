---
import NavigationBar from '@/components/ui/navigation-bar.astro';
import HeroSection from '@/components/ui/hero-section.astro';
import ProjectCard from '@/components/ui/project-card.astro';
import ExperienceItem from '@/components/ui/experience-item.astro';
import ContactForm from '@/components/ui/contact-form.astro';
import FooterSection from '@/components/ui/footer-section.astro';
import AnimationWrapper from '@/components/ui/animation-wrapper.astro';
import TestimonialsSection from '@/components/ui/testimonials-section.astro';
import CaseStudiesSection from '@/components/ui/case-studies-section.astro';
import PerformanceMonitor from '@/components/ui/performance-monitor.astro';

const homeResponse = await fetch(`${Astro.url.origin}/api/home`);
const homeData = homeResponse.ok ? await homeResponse.json() : null;

const aboutResponse = await fetch(`${Astro.url.origin}/api/about`);
const aboutData = aboutResponse.ok ? await aboutResponse.json() : null;

const experienceResponse = await fetch(`${Astro.url.origin}/api/experience`);
const experiences = experienceResponse.ok
  ? await experienceResponse.json()
  : [];

const projectsResponse = await fetch(`${Astro.url.origin}/api/project`);
const projects = projectsResponse.ok ? await projectsResponse.json() : [];

const siteUrl = 'https://msdqn.dev';
const siteName = 'Maulana Sodiqin - Fullstack Developer';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <title>
      {
        homeData?.title ||
          'Hire Maulana Sodiqin - Senior Fullstack Developer | React, TypeScript, Rust Expert'
      }
    </title>
    
    <meta
      name="description"
      content={homeData?.meta_description ||
        'Hire experienced Fullstack Developer Maulana Sodiqin. 5+ years React, TypeScript, Rust expertise. Available for full-time positions, freelance projects. Based in Malang, Indonesia. Open to remote work.'}
    />
    
    <meta
      name="keywords"
      content={homeData?.meta_keywords ||
        'hire fullstack developer, react developer for hire, typescript expert, rust developer, frontend developer job, software engineer hire, maulana sodiqin, fullstack developer malang, remote developer indonesia, react typescript developer, senior frontend developer, javascript developer hire, software engineer portfolio, web developer for hire, full stack engineer, react specialist, modern web developer'}
    />
    
    <meta name="author" content="Maulana Sodiqin" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="language" content="English" />
    <meta name="revisit-after" content="7 days" />
    <meta name="classification" content="Professional Portfolio" />
    <meta name="rating" content="General" />
    <meta name="distribution" content="Global" />
    <meta name="theme-color" content="#191724" />
    
    <link rel="canonical" href={siteUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    
    <meta property="og:title" content="Hire Maulana Sodiqin - Senior Fullstack Developer | React, TypeScript, Rust Expert" />
    <meta property="og:description" content="Experienced Fullstack Developer available for hire. 5+ years expertise in React, TypeScript, Rust. Open to full-time positions and freelance projects." />
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={`${siteUrl}/favicon.svg`} />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:image:alt" content="Maulana Sodiqin - Fullstack Developer Portfolio" />
    <meta property="og:locale" content="en_US" />
    <meta property="profile:first_name" content="Maulana" />
    <meta property="profile:last_name" content="Sodiqin" />
    <meta property="profile:username" content="maulanasdqn" />
    
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Hire Maulana Sodiqin - Senior Fullstack Developer" />
    <meta name="twitter:description" content="Experienced Fullstack Developer available for hire. 5+ years expertise in React, TypeScript, Rust." />
    <meta name="twitter:image" content={`${siteUrl}/favicon.svg`} />
    <meta name="twitter:image:alt" content="Maulana Sodiqin - Fullstack Developer Portfolio" />
    <meta name="twitter:creator" content="@maulanasdqn" />
    <meta name="twitter:site" content="@maulanasdqn" />
    
    <meta name="linkedin:owner" content="maulana-sodiqin" />
    
    <script type="application/ld+json">
      {
        JSON.stringify({
          "@context": "https://schema.org",
          "@type": "Person",
          "name": "Maulana Sodiqin",
          "givenName": "Maulana",
          "familyName": "Sodiqin",
          "url": siteUrl,
          "image": `${siteUrl}/favicon.svg`,
          "sameAs": [
            "https://www.linkedin.com/in/maulana-sodiqin/",
            "https://github.com/maulanasdqn",
            "mailto:maulanasdqn@gmail.com"
          ],
          "jobTitle": "Senior Fullstack Developer",
          "description": "Experienced Fullstack Developer with 5+ years of expertise in React, TypeScript, and Rust. Available for full-time positions and freelance projects.",
          "knowsAbout": [
            "React",
            "TypeScript",
            "JavaScript",
            "Rust",
            "Next.js",
            "Node.js",
            "Frontend Development",
            "Backend Development",
            "Full Stack Development",
            "Web Development",
            "Software Engineering",
            "UI/UX Development",
            "Modern Web Technologies"
          ],
          "alumniOf": {
            "@type": "EducationalOrganization",
            "name": "Education Institution"
          },
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Malang",
            "addressRegion": "East Java",
            "addressCountry": "Indonesia"
          },
          "email": "maulanasdqn@gmail.com",
          "telephone": "+6285156085579",
          "worksFor": {
            "@type": "Organization",
            "name": "Freelance Developer"
          },
          "hasOccupation": {
            "@type": "Occupation",
            "name": "Fullstack Developer",
            "occupationLocation": {
              "@type": "Place",
              "name": "Remote/Malang, Indonesia"
            },
