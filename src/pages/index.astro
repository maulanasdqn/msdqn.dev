            "skills": ["React", "TypeScript", "Rust", "JavaScript", "Node.js", "Next.js"]
          }
        })
      }
    </script>
    
    <script type="application/ld+json">
      {
        JSON.stringify({
          "@context": "https://schema.org",
          "@type": "WebSite",
          "name": siteName,
          "url": siteUrl,
          "description": "Professional portfolio of Maulana Sodiqin, Senior Fullstack Developer specializing in React, TypeScript, and Rust development.",
          "author": {
            "@type": "Person",
            "name": "Maulana Sodiqin"
          },
          "inLanguage": "en-US",
          "potentialAction": {
            "@type": "SearchAction",
            "target": {
              "@type": "EntryPoint",
              "urlTemplate": `${siteUrl}/?q={search_term_string}`
            },
            "query-input": "required name=search_term_string"
          }
        })
      }
    </script>
    
    <script type="application/ld+json">
      {
        JSON.stringify({
          "@context": "https://schema.org",
          "@type": "ProfessionalService",
          "name": "Maulana Sodiqin - Fullstack Development Services",
          "description": "Professional fullstack development services specializing in React, TypeScript, and Rust applications",
          "provider": {
            "@type": "Person",
            "name": "Maulana Sodiqin"
          },
          "areaServed": "Worldwide",
          "availableLanguage": "English",
          "priceRange": "$$",
          "serviceType": [
            "Fullstack Development",
            "Frontend Development",
            "Backend Development",
            "Web Application Development",
            "React Development",
            "TypeScript Development",
            "Rust Development"
          ]
        })
      }
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" href="/favicon.svg" as="image" />
    <link rel="dns-prefetch" href="//www.google-analytics.com" />
    
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){window.dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-XXXXXXXXXX');
    </script>
  </head>
  <body class="bg-rose-pine-base text-rose-pine-text">
    <PerformanceMonitor />
    <NavigationBar />

    <main>
      <section id="home">
        <HeroSection
          ctaText={homeData?.hero_cta_text || "Let's talk"}
          ctaLink={homeData?.hero_cta_link || '#contact'}
        />
      </section>

      <section id="about" class="py-16 px-6 bg-rose-pine-surface">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl font-bold mb-8 text-rose-pine-text text-center">
            About Me
          </h2>
          <div
            class="bg-rose-pine-overlay/50 backdrop-blur-sm p-8 rounded-xl border border-rose-pine-highlight-med"
          >
            <p class="text-rose-pine-subtle text-lg leading-relaxed mb-6">
              {
                aboutData?.description_1 ||
                  'I am proficient in modular UI architecture, design systems, test-driven development, and modern state management with React Query and Jotai. I have extensive experience working with micro frontend structures and NX monorepos to support large-scale applications.'
              }
            </p>
            <p class="text-rose-pine-subtle text-lg leading-relaxed">
              {
                aboutData?.description_2 ||
                  'Currently expanding my full-stack skills with Rust and Axum to gain deeper backend architecture understanding, while maintaining my expertise in modern frontend technologies.'
              }
            </p>
          </div>

          <div class="mt-16">
            <h3 class="text-2xl font-bold mb-8 text-rose-pine-text text-center">
              Technical Skills
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              <div
                class="bg-rose-pine-surface/50 backdrop-blur-sm p-6 rounded-xl border border-rose-pine-highlight-med"
              >
                <div
                  class="w-12 h-12 bg-rose-pine-iris/20 rounded-lg flex items-center justify-center mb-4"
                >
                  <svg
                    class="w-6 h-6 text-rose-pine-iris"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      d="M12 0l3.09 6.26L22 7.27l-5 4.87 1.18 6.88L12 15.77l-6.18 3.25L7 12.14 2 7.27l6.91-1.01L12 0z"
                    ></path>
                  </svg>
                </div>
                <h4 class="text-xl font-semibold mb-3 text-rose-pine-text">
                  Frontend Development
                </h4>
                <ul class="text-rose-pine-subtle space-y-1 text-sm">
                  <li>• ReactJS, NextJS, TypeScript</li>
                  <li>• JavaScript (ES6+)</li>
                  <li>• TailwindCSS, Shadcn, Ant Design</li>
                  <li>• HTML/CSS, Responsive Design</li>
                </ul>
              </div>

              <div
                class="bg-rose-pine-surface/50 backdrop-blur-sm p-6 rounded-xl border border-rose-pine-highlight-med"
              >
                <div
                  class="w-12 h-12 bg-rose-pine-love/20 rounded-lg flex items-center justify-center mb-4"
                >
                  <svg
                    class="w-6 h-6 text-rose-pine-love"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      d="M12 0l3.09 6.26L22 7.27l-5 4.87 1.18 6.88L12 15.77l-6.18 3.25L7 12.14 2 7.27l6.91-1.01L12 0z"
                    ></path>
                  </svg>
                </div>
                <h4 class="text-xl font-semibold mb-3 text-rose-pine-text">
                  State Management
                </h4>
                <ul class="text-rose-pine-subtle space-y-1 text-sm">
                  <li>• Tanstack React Query</li>
                  <li>• Jotai, Zustand, Recoil</li>
                  <li>• Redux</li>
                </ul>
              </div>

              <div
                class="bg-rose-pine-surface/50 backdrop-blur-sm p-6 rounded-xl border border-rose-pine-highlight-med"
              >
                <div
                  class="w-12 h-12 bg-rose-pine-foam/20 rounded-lg flex items-center justify-center mb-4"
                >
                  <svg
                    class="w-6 h-6 text-rose-pine-foam"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      d="M12 0l3.09 6.26L22 7.27l-5 4.87 1.18 6.88L12 15.77l-6.18 3.25L7 12.14 2 7.27l6.91-1.01L12 0z"
                    ></path>
                  </svg>
                </div>
                <h4 class="text-xl font-semibold mb-3 text-rose-pine-text">
                  Testing & Quality
                </h4>
                <ul class="text-rose-pine-subtle space-y-1 text-sm">
                  <li>• React Testing Library</li>
                  <li>• Vitest, Jest, MSW</li>
                  <li>• Test-Driven Development</li>
                </ul>
              </div>

              <div
                class="bg-rose-pine-surface/50 backdrop-blur-sm p-6 rounded-xl border border-rose-pine-highlight-med"
              >
                <div
                  class="w-12 h-12 bg-rose-pine-pine/20 rounded-lg flex items-center justify-center mb-4"
                >
                  <svg
                    class="w-6 h-6 text-rose-pine-pine"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      d="M12 0l3.09 6.26L22 7.27l-5 4.87 1.18 6.88L12 15.77l-6.18 3.25L7 12.14 2 7.27l6.91-1.01L12 0z"
                    ></path>
                  </svg>
                </div>
                <h4 class="text-xl font-semibold mb-3 text-rose-pine-text">
                  Frontend Architecture
                </h4>
                <ul class="text-rose-pine-subtle space-y-1 text-sm">
                  <li>• NX Monorepo</li>
                  <li>• Module Federation</li>
                  <li>• Micro Frontend</li>
                </ul>
              </div>

              <div
                class="bg-rose-pine-surface/50 backdrop-blur-sm p-6 rounded-xl border border-rose-pine-highlight-med"
              >
                <div
                  class="w-12 h-12 bg-rose-pine-gold/20 rounded-lg flex items-center justify-center mb-4"
                >
                  <svg
                    class="w-6 h-6 text-rose-pine-gold"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      d="M12 0l3.09 6.26L22 7.27l-5 4.87 1.18 6.88L12 15.77l-6.18 3.25L7 12.14 2 7.27l6.91-1.01L12 0z"
                    ></path>
                  </svg>
                </div>
                <h4 class="text-xl font-semibold mb-3 text-rose-pine-text">
                  Backend & Database
                </h4>
                <ul class="text-rose-pine-subtle space-y-1 text-sm">
                  <li>• Rust, Axum, SurrealDB</li>
                  <li>• PostgreSQL</li>
                  <li>• HonoJS, NestJS, ExpressJS</li>
                  <li>• Drizzle, Prisma, TypeORM</li>
                </ul>
              </div>

              <div
                class="bg-rose-pine-surface/50 backdrop-blur-sm p-6 rounded-xl border border-rose-pine-highlight-med"
              >
                <div
                  class="w-12 h-12 bg-rose-pine-rose/20 rounded-lg flex items-center justify-center mb-4"
                >
                  <svg
                    class="w-6 h-6 text-rose-pine-rose"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      d="M12 0l3.09 6.26L22 7.27l-5 4.87 1.18 6.88L12 15.77l-6.18 3.25L7 12.14 2 7.27l6.91-1.01L12 0z"
                    ></path>
                  </svg>
                </div>
                <h4 class="text-xl font-semibold mb-3 text-rose-pine-text">
                  UI Tooling & Design
                </h4>
                <ul class="text-rose-pine-subtle space-y-1 text-sm">
                  <li>• Storybook, Design Systems</li>
                  <li>• Component-Driven Development</li>
                  <li>• Performance Optimization</li>
                  <li>• Accessibility, Cross-Browser</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="experience" class="py-16 bg-rose-pine-base">
        <div class="max-w-4xl mx-auto px-6">
          <div class="text-center mb-16">
            <h2 class="text-4xl font-bold text-rose-pine-text mb-6">
              Experience & Skills
            </h2>
            <p
              class="text-lg text-rose-pine-subtle max-w-3xl mx-auto leading-relaxed mb-8"
            >
              Fullstack Developer with 5+ years building scalable web
              applications and leading development teams. Rust enthusiast
              exploring modern backend technologies.
            </p>
            <div
              class="flex flex-col sm:flex-row gap-4 justify-center items-center"
            >
              <a
                href="/resume.pdf"
                download="Maulana_Sodiqin_Resume.pdf"
                class="bg-rose-pine-love hover:bg-rose-pine-love/80 text-rose-pine-base px-8 py-4 rounded-xl font-semibold transition-all duration-300 transform hover:scale-105 inline-flex items-center gap-2"
              >
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                  ></path>
                </svg>
                Download Resume
              </a>
              <a
                href="mailto:maulanasdqn@gmail.com"
                class="bg-rose-pine-iris hover:bg-rose-pine-iris/80 text-rose-pine-base px-8 py-4 rounded-xl font-semibold transition-all duration-300 transform hover:scale-105 inline-flex items-center gap-2"
              >
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                  ></path>
                </svg>
                Contact Me
              </a>
            </div>
          </div>

          <div class="mb-20">
            <h3
              class="text-3xl font-bold text-rose-pine-text mb-12 flex items-center"
            >
              <svg
                class="w-8 h-8 mr-4 text-rose-pine-iris"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2-2v2m8 0V6a2 2 0 012 2v6a2 2 0 01-2 2H6a2 2 0 01-2-2V8a2 2 0 012-2V6"
                ></path>
              </svg>
              Work Experience
            </h3>

            {
              experiences &&
                experiences.length > 0 &&
                experiences.map((experience: any, index: number) => {
                  const animations = [
                    'slide-left',
                    'slide-right',
                    'rotate-in',
                  ] as const;
                  const animation = animations[index % animations.length];
                  const duration = `${experience.start_date}${experience.end_date ? ` - ${experience.end_date}` : ' - Present'}`;

                  return (
                    <AnimationWrapper animation={animation} distance={80}>
                      <ExperienceItem
                        title={experience.title}
                        company={experience.company}
                        duration={duration}
                        description={experience.description || ''}
                        responsibilities={experience.responsibilities || []}
                        type="work"
                      />
                    </AnimationWrapper>
                  );
                })
            }
          </div>

          <div class="mb-16">
            <div
              class="bg-rose-pine-surface/50 rounded-2xl p-8 border border-rose-pine-highlight-med"
            >
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 text-center">
                <div>
                  <div class="text-3xl font-bold text-rose-pine-iris mb-2">
                    {aboutData?.stats_years || '5+'}
                  </div>
                  <div class="text-rose-pine-subtle font-medium">
                    Years Experience
                  </div>
                </div>
                <div>
                  <div class="text-3xl font-bold text-rose-pine-foam mb-2">
                    {aboutData?.stats_projects || '10+'}
                  </div>
                  <div class="text-rose-pine-subtle font-medium">
                    Projects Delivered
                  </div>
                </div>
                <div>
                  <div class="text-3xl font-bold text-rose-pine-rose mb-2">
                    {aboutData?.stats_users || '1000+'}
                  </div>
                  <div class="text-rose-pine-subtle font-medium">
                    Users Served
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <CaseStudiesSection />

      <TestimonialsSection />

      <section id="projects" class="py-16 px-6 bg-rose-pine-surface">
        <div class="max-w-7xl mx-auto">
          <div class="text-center mb-16">
            <h2 class="text-4xl font-bold mb-6 text-rose-pine-text">
              My Projects
            </h2>
            <p
              class="text-xl text-rose-pine-subtle max-w-3xl mx-auto leading-relaxed"
            >
              A showcase of innovative software solutions I've built over the
              years, from enterprise applications to specialized platforms
              serving thousands of users.
            </p>
          </div>

          <div
            class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-8 auto-rows-fr"
            data-stagger="150"
          >
            {
              projects &&
                projects.length > 0 &&
                projects.map((project: any, index: number) => {
                  const animations = [
                    'fade-up',
                    'scale-up',
                    'fade-right',
                    'zoom-in',
                    'flip-up',
                    'bounce-in',
                  ] as const;
                  const animation = animations[index % animations.length];

                  return (
                    <AnimationWrapper
                      animation={animation}
                      distance={50}
                      class="h-full"
                    >
                      <ProjectCard
                        title={project.title}
                        description={project.description || ''}
                        technologies={project.technologies || []}
                        period={
                          project.start_date
                            ? `${project.start_date}${project.end_date ? ` – ${project.end_date}` : ''}`
                            : undefined
                        }
                        category={project.category || undefined}
                        demoLink={project.live_url || undefined}
                        githubLink={project.github_url || undefined}
                        highlights={project.is_featured ? ['Featured'] : []}
                      />
                    </AnimationWrapper>
                  );
                })
            }
          </div>
        </div>
      </section>

      <section id="contact" class="py-20 bg-rose-pine-base">
        <div class="max-w-6xl mx-auto px-6">
          <div class="text-center mb-20">
            <h2 class="text-5xl font-bold text-rose-pine-text mb-8">
              Let's Connect
