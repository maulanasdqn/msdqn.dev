---
import NavigationBar from '../components/ui/navigation-bar.astro';
import ContactForm from '../components/ui/contact-form.astro';
import FooterSection from '../components/ui/footer-section.astro';
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>Contact - Maulana Sodiqin | Get In Touch</title>
		<meta name="description" content="Get in touch with Maulana Sodiqin for collaboration opportunities, job inquiries, or project discussions. Connect via email or social media." />
		<meta name="keywords" content="contact, get in touch, collaboration, job opportunities, email, social media, maulana sodiqin, software engineer" />
		<meta property="og:title" content="Contact - Maulana Sodiqin | Get In Touch" />
		<meta property="og:description" content="Get in touch for collaboration opportunities, job inquiries, or project discussions." />
		<meta property="og:type" content="website" />
	</head>
	<body class="bg-rose-pine-base">
		<NavigationBar currentPath="/contact" />
		
		<main class="pt-20">
			<section class="py-20 bg-rose-pine-base">
				<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
					<div class="text-center mb-20">
						<h1 class="text-5xl md:text-6xl font-bold text-rose-pine-text mb-8">Let's Connect</h1>
						<p class="text-xl text-rose-pine-subtle max-w-3xl mx-auto leading-relaxed">
							I'm always interested in discussing new opportunities, collaborations, or just having a chat about technology. Feel free to reach out!
						</p>
					</div>
					
					<div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
						<div>
							<ContactForm />
						</div>
						
						<div class="space-y-8">
							<div>
								<h2 class="text-3xl font-bold text-rose-pine-text mb-8">Other Ways to Reach Me</h2>
								
								<div class="space-y-6">
									<div class="flex items-center p-6 bg-rose-pine-surface/50 backdrop-blur-sm rounded-2xl hover:bg-rose-pine-surface/70 transition-all duration-300 border border-rose-pine-highlight-med">
										<div class="w-12 h-12 bg-rose-pine-iris rounded-xl flex items-center justify-center mr-4">
											<svg class="w-6 h-6 text-rose-pine-base" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
											</svg>
										</div>
										<div>
											<h3 class="font-semibold text-rose-pine-text">Email</h3>
											<a href="mailto:maulanasdqn@gmail.com" class="text-rose-pine-iris hover:text-rose-pine-iris/80 transition-colors">
												maulanasdqn@gmail.com
											</a>
										</div>
									</div>
									
									<div class="flex items-center p-6 bg-rose-pine-surface/50 backdrop-blur-sm rounded-2xl hover:bg-rose-pine-surface/70 transition-all duration-300 border border-rose-pine-highlight-med">
										<div class="w-12 h-12 bg-rose-pine-iris rounded-xl flex items-center justify-center mr-4">
											<svg class="w-6 h-6 text-rose-pine-base" fill="currentColor" viewBox="0 0 24 24">
												<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
											</svg>
										</div>
										<div>
