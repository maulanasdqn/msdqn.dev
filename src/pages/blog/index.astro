---
import BlogPostCard from '@/components/ui/blog-post-card.astro';
import FooterSection from '@/components/ui/footer-section.astro';
import NavigationBar from '@/components/ui/navigation-bar.astro';
import SeoHead from '@/components/ui/seo-head.astro';
import { getDb } from '@/libs/d1';
import {
  breadcrumbs,
  graph,
  person,
  PERSON_ID,
  SITE_URL,
  website,
  WEBSITE_ID,
} from '@/libs/seo';

type TBlogPost = {
  title: string;
  description: string;
  pubDate: string;
  link: string;
  slug: string;
};

let posts: TBlogPost[] = [];
try {
  const { results } = await getDb(Astro.locals)
    .prepare(
      'SELECT slug, title, excerpt, COALESCE(published_at, created_at) AS published FROM blog_posts WHERE published = 1 ORDER BY published DESC'
    )
    .all<{
      slug: string;
      title: string;
      excerpt: string | null;
      published: string;
    }>();
  posts = results.map(row => ({
    title: row.title,
    description: row.excerpt ?? '',
    pubDate: row.published,
    link: `https://blog.msdqn.dev/blog/${row.slug}`,
    slug: row.slug,
  }));
} catch (e) {
  console.error('Failed to load blog posts:', e);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SeoHead
      title="Writing | Maulana Sodiqin"
      description="Notes and tutorials by Maulana Sodiqin on building web platforms with Rust and TypeScript, from backend systems to browser automation."
      path="/blog"
      noindex={posts.length === 0}
      jsonLd={graph(person, website, breadcrumbs('Writing', '/blog'), {
        '@type': 'Blog',
        '@id': `${SITE_URL}/blog#blog`,
        url: `${SITE_URL}/blog`,
        name: 'Writing | Maulana Sodiqin',
        inLanguage: 'en',
        isPartOf: { '@id': WEBSITE_ID },
        author: { '@id': PERSON_ID },
        breadcrumb: { '@id': `${SITE_URL}/blog#breadcrumb` },
        blogPost: posts.map(post => ({
          '@type': 'BlogPosting',
          headline: post.title,
          description: post.description,
          datePublished: post.pubDate,
          url: post.link,
          author: { '@id': PERSON_ID },
        })),
      })}
    />
  </head>

  <body class="bg-mono-bg text-mono-text antialiased">
    <NavigationBar />

    <main class="max-w-5xl mx-auto px-6 sm:px-8 pt-36 sm:pt-44 pb-24">
      <p
        class="text-xs font-medium uppercase tracking-[0.14em] text-mono-muted mb-10"
      >
        Writing
      </p>
      <h1
        class="font-medium text-5xl sm:text-6xl tracking-tight text-mono-text max-w-3xl"
      >
        Notes on the web, React, TypeScript, and Rust.
      </h1>
      <p class="mt-8 max-w-xl text-lg leading-relaxed text-mono-subtle">
        Tutorials and thoughts from building software. Posts live on
        <a
          href="https://blog.msdqn.dev"
          class="text-mono-text underline decoration-mono-line-strong underline-offset-[6px] hover:decoration-mono-text"
          >blog.msdqn.dev</a
        >.
      </p>

      <div class="mt-20 border-t border-mono-line pt-8">
        {
          posts.length === 0 ? (
            <p class="text-mono-subtle">No posts yet. Check back soon.</p>
          ) : (
            posts.map(post => (
              <BlogPostCard
                title={post.title}
                excerpt={post.description}
                href={post.link || `/blog/${post.slug}`}
                publishedAt={post.pubDate}
              />
            ))
          )
        }
      </div>
    </main>

    <FooterSection />
  </body>
</html>
