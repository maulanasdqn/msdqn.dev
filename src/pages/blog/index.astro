---
import BlogPostCard from '@/components/ui/blog-post-card.astro';
import FooterSection from '@/components/ui/footer-section.astro';
import NavigationBar from '@/components/ui/navigation-bar.astro';

const siteUrl = 'https://msdqn.dev';

function parseRSS(xml: string) {
  const items = xml.match(/<item>([\s\S]*?)<\/item>/g) ?? [];
  return items.map(item => {
    const get = (tag: string) => {
      const cdataMatch = item.match(
        new RegExp(`<${tag}><!\\[CDATA\\[([\\s\\S]*?)\\]\\]><\\/${tag}>`)
      );
      if (cdataMatch) return cdataMatch[1].trim();
      const plainMatch = item.match(
        new RegExp(`<${tag}>([\\s\\S]*?)<\\/${tag}>`)
      );
      return plainMatch ? plainMatch[1].trim() : '';
    };
    const link = get('link');
    const slug = link.split('/').filter(Boolean).pop() ?? '';
    return {
      title: get('title'),
      description: get('description'),
      pubDate: get('pubDate'),
      link,
      slug,
    };
  });
}

let posts: ReturnType<typeof parseRSS> = [];
try {
  const res = await fetch('https://blog.msdqn.dev/rss.xml');
  const xml = await res.text();
  posts = parseRSS(xml);
} catch (e) {
  console.error('Failed to fetch blog posts:', e);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#0a0a0a" />

    <title>Writing — Maulana Sodiqin</title>

    <meta
      name="description"
      content="Technical blog by Maulana Sodiqin covering React, TypeScript, Rust, and modern web development. Insights, tutorials, and best practices from a senior fullstack developer."
    />

    <meta
      name="keywords"
      content="react blog, typescript tutorials, rust programming, fullstack development blog, web development insights, maulana sodiqin blog, tech articles"
    />

    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={`${siteUrl}/blog`} />

    <meta property="og:title" content="Writing — Maulana Sodiqin" />
    <meta
      property="og:description"
      content="Technical insights and tutorials on React, TypeScript, and Rust development"
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${siteUrl}/blog`} />
    <meta property="og:image" content={`${siteUrl}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${siteUrl}/og-image.png`} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Blog',
        name: 'Maulana Sodiqin Tech Blog',
        description:
          'Technical blog covering React, TypeScript, Rust, and modern web development',
        url: `${siteUrl}/blog`,
        author: {
          '@type': 'Person',
          name: 'Maulana Sodiqin',
        },
        blogPost: posts.map(post => ({
          '@type': 'BlogPosting',
          headline: post.title,
          description: post.description,
          datePublished: post.pubDate,
          author: {
            '@type': 'Person',
            name: 'Maulana Sodiqin',
          },
          url: post.link,
        })),
      })}
    />
  </head>

  <body class="bg-mono-bg text-mono-text antialiased">
    <NavigationBar />

    <main class="max-w-5xl mx-auto px-6 sm:px-8 pt-36 sm:pt-44 pb-24">
      <p
        class="text-xs font-medium uppercase tracking-[0.14em] text-mono-muted mb-10"
      >
        Writing
      </p>
      <h1
        class="font-medium text-5xl sm:text-6xl tracking-tight text-mono-text max-w-3xl"
      >
        Notes on the web, React, TypeScript, and Rust.
      </h1>
      <p class="mt-8 max-w-xl text-lg leading-relaxed text-mono-subtle">
        Tutorials and thoughts from building software. Posts live on
        <a
          href="https://blog.msdqn.dev"
          class="text-mono-text underline decoration-mono-line-strong underline-offset-[6px] hover:decoration-mono-text"
          >blog.msdqn.dev</a
        >.
      </p>

      <div class="mt-20 border-t border-mono-line pt-8">
        {
          posts.length === 0 ? (
            <p class="text-mono-subtle">No posts yet. Check back soon.</p>
          ) : (
            posts.map(post => (
              <BlogPostCard
                title={post.title}
                excerpt={post.description}
                slug={post.slug}
                publishedAt={post.pubDate}
              />
            ))
          )
        }
      </div>
    </main>

    <FooterSection />
  </body>
</html>
