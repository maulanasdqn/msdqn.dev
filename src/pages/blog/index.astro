---
import AnalyticsPartytown from '@/components/ui/analytics-partytown.astro';
import BlogPostCard from '@/components/ui/blog-post-card.astro';
import FooterSection from '@/components/ui/footer-section.astro';
import NavigationBar from '@/components/ui/navigation-bar.astro';
import { supabase } from '@/libs/supabase';

const siteUrl = 'https://msdqn.dev';

const { data: blogPosts, error } = await supabase
  .from('blog_posts')
  .select('*')
  .eq('published', true)
  .order('published_at', { ascending: false })
  .limit(12);

if (error) {
  console.error('Error fetching blog posts:', error.message);
}

const posts = blogPosts || [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <AnalyticsPartytown />

    <title>
      Tech Blog - Maulana Sodiqin | React, TypeScript, Rust Insights
    </title>

    <meta
      name="description"
      content="Technical blog by Maulana Sodiqin covering React, TypeScript, Rust, and modern web development. Insights, tutorials, and best practices from a senior fullstack developer."
    />

    <meta
      name="keywords"
      content="react blog, typescript tutorials, rust programming, fullstack development blog, web development insights, maulana sodiqin blog, tech articles"
    />

    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={`${siteUrl}/blog`} />

    <meta property="og:title" content="Tech Blog - Maulana Sodiqin" />
    <meta
      property="og:description"
      content="Technical insights and tutorials on React, TypeScript, and Rust development"
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${siteUrl}/blog`} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Blog',
        name: 'Maulana Sodiqin Tech Blog',
        description:
          'Technical blog covering React, TypeScript, Rust, and modern web development',
        url: `${siteUrl}/blog`,
        author: {
          '@type': 'Person',
          name: 'Maulana Sodiqin',
        },
        blogPost: posts.map(post => ({
          '@type': 'BlogPosting',
          headline: post.title,
          description: post.excerpt,
          datePublished: post.published_at || post.created_at,
          author: {
            '@type': 'Person',
            name: 'Maulana Sodiqin',
          },
          url: `${siteUrl}/blog/${post.slug}`,
        })),
      })}
    />
  </head>

  <body class="bg-rose-pine-base text-rose-pine-text">
    <NavigationBar />

    <main class="pt-20">
      <section class="py-20 px-6">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-16">
            <h1 class="text-5xl font-bold text-rose-pine-text mb-6">
              Tech Blog
            </h1>
            <p
              class="text-xl text-rose-pine-subtle max-w-3xl mx-auto leading-relaxed"
            >
              Insights, tutorials, and thoughts on modern web development, React
              ecosystems, TypeScript best practices, and Rust exploration.
            </p>
          </div>

          {posts.length === 0 ? (
            <div class="text-center py-20">
              <div class="text-6xl mb-6">📝</div>
              <h2 class="text-2xl font-bold text-rose-pine-text mb-4">No blog posts yet</h2>
              <p class="text-rose-pine-subtle">Check back soon for insights and tutorials!</p>
            </div>
          ) : (
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
              {
                posts.map(post => (
                  <BlogPostCard
                    title={post.title}
                    excerpt={post.excerpt}
                    slug={post.slug}
                    publishedAt={post.published_at || post.created_at}
                    readTime={post.read_time || '5 min read'}
                    tags={post.tags || []}
                    featured={post.featured || false}
                  />
                ))
              }
            </div>
          )}

          <div class="mt-16 text-center">
            <p class="text-rose-pine-subtle">
              More articles coming soon. Subscribe to stay updated with the
              latest insights.
            </p>
          </div>
        </div>
      </section>
    </main>

    <FooterSection />
  </body>
</html>
