---
import AnalyticsPartytown from '@/components/ui/analytics-partytown.astro';
import BlogTags from '@/components/ui/blog-tags.astro';
import FooterSection from '@/components/ui/footer-section.astro';
import NavigationBar from '@/components/ui/navigation-bar.astro';
import { processMarkdown } from '@/libs/markdown';
import { supabase } from '@/libs/supabase';

const { slug } = Astro.params;
const siteUrl = 'https://msdqn.dev';

if (!slug) {
  return Astro.redirect('/blog', 302);
}

const { data: post, error } = await supabase
  .from('blog_posts')
  .select('*')
  .eq('slug', slug)
  .eq('published', true)
  .single();

if (error || !post) {
  return Astro.redirect('/blog', 302);
}

const formattedDate = new Date(
  post.published_at || post.created_at
).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const processedContent = await processMarkdown(post.content);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <AnalyticsPartytown />

    <style>
      /* Rose Pine CSS Variables */
      :root {
        --rp-base: #191724;
        --rp-surface: #1f1d2e;
        --rp-overlay: #26233a;
        --rp-muted: #6e6a86;
        --rp-subtle: #908caa;
        --rp-text: #e0def4;
        --rp-love: #eb6f92;
        --rp-gold: #f6c177;
        --rp-rose: #ebbcba;
        --rp-pine: #31748f;
        --rp-foam: #9ccfd8;
        --rp-iris: #c4a7e7;
      }

      /* Prism Rose Pine Theme */
      pre[class*='language-'] {
        background: var(--rp-surface) !important;
        border: 1px solid var(--rp-overlay) !important;
        border-radius: 8px;
        padding: 1rem !important;
        overflow-x: auto;
        font-size: 0.875rem;
        line-height: 1.5;
        margin: 1.5rem 0;
      }

      code[class*='language-'],
      pre[class*='language-'] {
        color: var(--rp-text);
        background: none;
        font-family:
          'JetBrains Mono', 'Fira Code', 'SF Mono', Consolas, 'Courier New',
          monospace;
        text-align: left;
        white-space: pre;
        word-spacing: normal;
        word-break: normal;
        word-wrap: normal;
        line-height: 1.5;
        tab-size: 4;
        hyphens: none;
      }

      /* Inline code - not in pre blocks */
      :not(pre) > code {
        background: var(--rp-surface) !important;
        color: var(--rp-foam) !important;
        padding: 0.125rem 0.375rem !important;
        border-radius: 0.25rem !important;
        font-size: 0.875rem !important;
        font-family:
          'JetBrains Mono', 'Fira Code', 'SF Mono', Consolas, 'Courier New',
          monospace !important;
      }

      /* Code blocks without language class */
      pre > code {
        background: none !important;
        color: var(--rp-text) !important;
        padding: 0 !important;
      }

      /* Syntax highlighting tokens */
      .token.comment,
      .token.prolog,
      .token.doctype,
      .token.cdata {
        color: var(--rp-muted);
        font-style: italic;
      }

      .token.punctuation {
        color: var(--rp-subtle);
      }

      .token.property,
      .token.tag,
      .token.constant,
      .token.symbol,
      .token.deleted {
        color: var(--rp-love);
      }

      .token.boolean,
      .token.number {
        color: var(--rp-gold);
      }

      .token.selector,
      .token.attr-name,
      .token.string,
      .token.char,
      .token.builtin,
      .token.inserted {
        color: var(--rp-pine);
      }

      .token.operator,
      .token.entity,
      .token.url,
      .language-css .token.string,
      .style .token.string,
      .token.variable {
        color: var(--rp-rose);
      }

      .token.atrule,
      .token.attr-value,
      .token.function,
      .token.class-name {
        color: var(--rp-foam);
      }

      .token.keyword {
        color: var(--rp-iris);
      }

      .token.regex,
      .token.important {
        color: var(--rp-gold);
      }

      /* Language-specific highlighting */
      .token.namespace {
        opacity: 0.7;
      }

      .token.important,
      .token.bold {
        font-weight: bold;
      }

      .token.italic {
        font-style: italic;
      }

      .token.entity {
        cursor: help;
      }

      /* Anchor links */
      .anchor-link {
        text-decoration: none;
        color: inherit;
      }

      .anchor-link:hover {
        text-decoration: underline;
      }
    </style>

    <title>{post.meta_title || post.title} - Maulana Sodiqin</title>

    <meta name="description" content={post.meta_description || post.excerpt} />

    <meta
      name="keywords"
      content={post.tags
        ? post.tags.join(', ')
        : 'web development, programming, tech blog'}
    />

    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={`${siteUrl}/blog/${post.slug}`} />

    <meta property="og:title" content={post.title} />
    <meta property="og:description" content={post.excerpt} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={`${siteUrl}/blog/${post.slug}`} />
    <meta
      property="article:published_time"
      content={post.published_at || post.created_at}
    />
    <meta property="article:author" content="Maulana Sodiqin" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: post.title,
        description: post.excerpt,
        datePublished: post.published_at || post.created_at,
        dateModified: post.updated_at,
        author: {
          '@type': 'Person',
          name: 'Maulana Sodiqin',
        },
        url: `${siteUrl}/blog/${post.slug}`,
        keywords: post.tags?.join(', '),
      })}
    />
  </head>

  <body class="bg-rose-pine-base text-rose-pine-text">
    <NavigationBar />

    <main class="pt-20">
      <article class="py-20 px-6">
        <div class="max-w-4xl mx-auto">
          <header class="mb-12">
            <div class="mb-6">
              <a
                href="/blog"
                class="inline-flex items-center text-rose-pine-subtle hover:text-rose-pine-text transition-colors"
              >
                <svg
                  class="w-4 h-4 mr-2"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 19l-7-7 7-7"></path>
                </svg>
                Back to Blog
              </a>
            </div>

            <h1
              class="text-4xl md:text-5xl font-bold text-rose-pine-text mb-6 leading-tight"
            >
              {post.title}
            </h1>

            <div class="flex items-center gap-6 text-rose-pine-subtle mb-8">
              <time datetime={post.published_at || post.created_at}>
                {formattedDate}
              </time>
              <span>{post.read_time}</span>
            </div>

            <div class="mb-8">
              <BlogTags tags={post.tags || []} variant="large" />
            </div>
          </header>

          <div
            class="prose prose-lg prose-invert max-w-none
                      prose-headings:text-rose-pine-text
                      prose-p:text-rose-pine-text prose-p:leading-relaxed
                      prose-a:text-rose-pine-love prose-a:no-underline hover:prose-a:text-rose-pine-love/80
                      prose-strong:text-rose-pine-text
                      prose-code:text-rose-pine-foam prose-code:bg-rose-pine-surface prose-code:px-1 prose-code:py-0.5 prose-code:rounded prose-code:text-sm
                      prose-pre:bg-rose-pine-surface prose-pre:border prose-pre:border-rose-pine-highlight-med prose-pre:overflow-x-auto
                      prose-blockquote:border-l-rose-pine-love prose-blockquote:text-rose-pine-subtle
                      prose-ul:text-rose-pine-text prose-ol:text-rose-pine-text
                      prose-li:text-rose-pine-text
                      prose-table:text-rose-pine-text prose-thead:border-rose-pine-highlight-med
                      prose-tbody:border-rose-pine-highlight-med prose-tr:border-rose-pine-highlight-med"
          >
            <div set:html={processedContent} />
          </div>

          <footer class="mt-16 pt-8 border-t border-rose-pine-highlight-med">
            <div class="text-center">
              <p class="text-rose-pine-subtle mb-4">
                Found this article helpful? Share it with others!
              </p>
              <div class="flex justify-center gap-4">
                <a
                  href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.title)}&url=${encodeURIComponent(`${siteUrl}/blog/${post.slug}`)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-rose-pine-love hover:text-rose-pine-love/80 font-medium transition-colors"
                >
                  Share on Twitter
                </a>
                <a
                  href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(`${siteUrl}/blog/${post.slug}`)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-rose-pine-love hover:text-rose-pine-love/80 font-medium transition-colors"
                >
                  Share on LinkedIn
                </a>
              </div>
            </div>
          </footer>
        </div>
      </article>
    </main>

    <FooterSection />

    <!-- Prism.js CDN -->
    <script
      src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-core.min.js"
    ></script>
    <script
      src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/plugins/autoloader/prism-autoloader.min.js"
    ></script>

    <script is:inline>
      // Initialize Prism and enhance code blocks
      document.addEventListener('DOMContentLoaded', function () {
        // Process all code blocks
        const codeBlocks = document.querySelectorAll('pre code');
        codeBlocks.forEach(function (block) {
          const pre = block.parentElement;

          // Detect language from code block or fence
          let language = '';
          const codeText = block.textContent || '';

          // Try to detect language from various sources
          if (block.className && block.className.includes('language-')) {
            language = block.className.match(/language-(\w+)/)?.[1] || '';
          } else if (pre.className && pre.className.includes('language-')) {
            language = pre.className.match(/language-(\w+)/)?.[1] || '';
          } else {
            // Try to auto-detect common patterns
            if (
              codeText.includes('interface ') ||
              codeText.includes(': string') ||
              codeText.includes('React.FC')
            ) {
              language = 'typescript';
            } else if (
              codeText.includes('function ') &&
              codeText.includes('console.log')
            ) {
              language = 'javascript';
            } else if (
              codeText.includes('fn ') ||
              codeText.includes('let mut')
            ) {
              language = 'rust';
            } else if (
              codeText.includes('def ') ||
              codeText.includes('import ')
            ) {
              language = 'python';
            } else {
              language = 'text';
            }
          }

          // Set proper classes
          if (language) {
            block.className = `language-${language}`;
            pre.className = `language-${language}`;
          }
        });

        // Let Prism highlight everything
        if (window.Prism) {
          Prism.highlightAll();
        }

        // Add enhanced functionality after highlighting
        setTimeout(function () {
          addCopyButtons();
        }, 100);
      });

      function addCopyButtons() {
        const preElements = document.querySelectorAll(
          'pre[class*="language-"]'
        );
        preElements.forEach(function (pre) {
          // Skip if copy button already exists
          if (pre.querySelector('.copy-code-button')) return;

          // Create copy button
          const copyButton = document.createElement('button');
          copyButton.className = 'copy-code-button';
          copyButton.innerHTML = '📋';
          copyButton.title = 'Copy code';
          copyButton.style.cssText = `
            position: absolute;
            top: 0.5rem;
            right: 0.5rem;
            background: var(--rp-overlay);
            border: 1px solid var(--rp-muted);
            color: var(--rp-text);
            padding: 0.25rem 0.5rem;
            border-radius: 0.25rem;
            cursor: pointer;
            font-size: 0.75rem;
            opacity: 0;
            transition: opacity 0.2s;
            z-index: 10;
          `;

          // Position the pre element relatively
          pre.style.position = 'relative';

          // Show/hide copy button on hover
          pre.addEventListener('mouseenter', function () {
            copyButton.style.opacity = '1';
          });

          pre.addEventListener('mouseleave', function () {
            copyButton.style.opacity = '0';
          });

          // Copy functionality
          copyButton.addEventListener('click', function () {
            const code = pre.querySelector('code');
            if (code) {
              navigator.clipboard.writeText(code.textContent).then(function () {
                copyButton.innerHTML = '✓';
                copyButton.style.background = 'var(--rp-pine)';
                setTimeout(function () {
                  copyButton.innerHTML = '📋';
                  copyButton.style.background = 'var(--rp-overlay)';
                }, 2000);
              });
            }
          });

          pre.appendChild(copyButton);
        });
      }
    </script>
  </body>
</html>
