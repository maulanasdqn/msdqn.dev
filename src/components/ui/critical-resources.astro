---
// Critical resource preloading for optimal PageSpeed performance
interface Props {
  priorityImage?: string;
  heroImage?: string;
  critical?: boolean;
}

const { priorityImage, heroImage, critical = true } = Astro.props;
---

<!-- Critical DNS and Connection Setup -->
<link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />

<!-- DNS Prefetch for External Resources -->
<link rel="dns-prefetch" href="//www.google-analytics.com" />
<link rel="dns-prefetch" href="//googletagmanager.com" />
<link rel="dns-prefetch" href="//vercel-insights.com" />

<!-- Critical Font Preloading - only if Inter is actually used -->
<link
  rel="preload"
  href="https://fonts.gstatic.com/s/inter/v13/UcCO3FwrK3iLTeHuS_fvQtMwCp50KnMw2boKoduKmMEVuLyfAZ9hiA.woff2"
  as="font"
  type="font/woff2"
  crossorigin
  media="(min-width: 0)"
/>

<!-- Critical Asset Preloading -->
<link rel="preload" href="/favicon.svg" as="image" type="image/svg+xml" />

{
  priorityImage && (
    <link rel="preload" href={priorityImage} as="image" fetchpriority="high" />
  )
}

{
  heroImage && (
    <link rel="preload" href={heroImage} as="image" fetchpriority="high" />
  )
}

<!-- Prefetch Important Resources -->
<link rel="prefetch" href="/resume.pdf" />
<link rel="prefetch" href="/sitemap.xml" />

<!-- Module Preloading for Critical JavaScript -->
{
  critical && (
    <>
      <!-- Only preload actual built JS modules, not source files -->
    </>
  )
}

<!-- Resource Hints for Better Performance -->
<link rel="prefetch" href="/api/home" />
<link rel="prefetch" href="/api/about" />

<!-- Critical CSS Inline -->
<style>
  /* Critical above-the-fold styles */
  html {
    font-family:
      -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu,
      Cantarell, sans-serif;
    line-height: 1.6;
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
  }

  body {
    margin: 0;
    padding: 0;
    background-color: #191724;
    color: #e0def4;
    font-display: swap;
  }

  /* Critical navigation styles */
  nav {
    background-color: #1f1d2e;
    position: sticky;
    top: 0;
    z-index: 100;
    contain: layout style paint;
  }

  /* Critical hero section styles */
  .hero {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    contain: layout style;
  }

  /* Image optimization */
  img {
    max-width: 100%;
    height: auto;
    content-visibility: auto;
    contain-intrinsic-size: 300px 200px;
  }

  /* Performance optimizations */
  .will-change-transform {
    will-change: transform;
  }

  .will-change-opacity {
    will-change: opacity;
  }

  /* Layout containment */
  .contain-layout {
    contain: layout;
  }

  .contain-paint {
    contain: paint;
  }

  .contain-style {
    contain: style;
  }

  /* Critical responsive design */
  @media (max-width: 768px) {
    .hero {
      min-height: 50vh;
      padding: 1rem;
    }
  }

  /* Reduced motion preferences */
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }

  /* High contrast mode */
  @media (prefers-contrast: high) {
    :root {
      --text-contrast: #ffffff;
      --bg-contrast: #000000;
    }

    body {
      background-color: var(--bg-contrast) !important;
      color: var(--text-contrast) !important;
    }

    .text-rose-pine-subtle,
    .text-rose-pine-muted {
      color: #ffffff !important;
    }

    .bg-rose-pine-surface,
    .bg-rose-pine-overlay {
      background-color: #1a1a1a !important;
    }
  }

  /* Improved focus indicators for accessibility */
  *:focus {
    outline: 2px solid #c4a7e7;
    outline-offset: 2px;
  }

  /* Better link contrast */
  a {
    text-decoration-skip-ink: auto;
  }

  a:focus,
  a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
</style>

<!-- Critical Performance Script -->
<script is:inline>
  // Critical performance optimizations
  (function () {
    'use strict';

    try {
      // Early performance marker
      if (typeof performance !== 'undefined' && performance.mark) {
        performance.mark('critical-resources-start');
      }

      // Optimize font loading
      if (typeof document !== 'undefined' && 'fonts' in document) {
        try {
          document.fonts.load('400 16px system-ui, -apple-system, sans-serif');
        } catch (fontError) {
          // Font loading failed, continue silently
        }
      }

      // Early connection warming
      if (typeof navigator !== 'undefined' && 'serviceWorker' in navigator) {
        try {
          navigator.serviceWorker.register('/sw.js').catch(() => {
            // Service worker registration failed, continue silently
          });
        } catch (swError) {
          // Service worker not supported, continue silently
        }
      }

      // Early viewport optimization
      if (typeof document !== 'undefined') {
        try {
          const viewport = document.querySelector('meta[name="viewport"]');
          if (!viewport && document.head) {
            const meta = document.createElement('meta');
            meta.name = 'viewport';
            meta.content = 'width=device-width, initial-scale=1.0';
            document.head.appendChild(meta);
          }
        } catch (viewportError) {
          // Viewport meta creation failed, continue silently
        }
      }

      // Critical resource loaded marker
      if (typeof document !== 'undefined' && document.addEventListener) {
        document.addEventListener('DOMContentLoaded', function () {
          try {
            if (
              typeof performance !== 'undefined' &&
              performance.mark &&
              performance.measure
            ) {
              performance.mark('critical-resources-end');
              performance.measure(
                'critical-resources-duration',
                'critical-resources-start',
                'critical-resources-end'
              );
            }
          } catch (perfError) {
            // Performance measurement failed, continue silently
          }
        });
      }
    } catch (error) {
      // Critical script initialization failed, continue silently
      // This prevents any console errors from breaking the page
    }
  })();
</script>
