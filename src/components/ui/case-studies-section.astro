---
import CaseStudyCard from './case-study-card.astro';
import SectionHeading from './section-heading.astro';

interface Props {
  number: string;
  caseStudies: Record<string, any>[];
}

const { number, caseStudies } = Astro.props;
---

<section
  id="case-studies"
  class="max-w-5xl mx-auto px-6 sm:px-8 py-16 sm:py-20"
  aria-labelledby="case-studies-heading"
>
  <SectionHeading
    number={number}
    title="Case Studies"
    id="case-studies-heading"
  />
  <div>
    {
      caseStudies.map(study => (
        <CaseStudyCard
          title={study.title}
          client={study.client}
          duration={study.duration}
          technologies={study.technologies}
          challenge={study.challenge}
          solution={study.solution}
          results={study.results}
        />
      ))
    }
  </div>
</section>
