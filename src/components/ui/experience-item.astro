---
interface Props {
  title: string;
  company: string;
  duration: string;
  description: string;
  responsibilities?: string[];
  employmentType?: string;
}

const {
  title,
  company,
  duration,
  description,
  responsibilities,
  employmentType,
} = Astro.props;
---

<article
  class="grid grid-cols-1 md:grid-cols-12 gap-2 md:gap-8 py-10 border-b border-mono-line first:pt-0"
>
  <p class="md:col-span-3 text-xs text-mono-muted tabular-nums pt-1.5">
    {duration}
  </p>
  <div class="md:col-span-9">
    <h3 class="font-medium text-2xl tracking-tight text-mono-text">
      {title}
    </h3>
    <p class="mt-1 text-mono-subtle">
      {company}
      {
        employmentType && (
          <span class="text-mono-muted"> &middot; {employmentType}</span>
        )
      }
    </p>
    {
      description && (
        <p class="mt-5 text-mono-subtle leading-relaxed">{description}</p>
      )
    }
    {
      responsibilities && responsibilities.length > 0 && (
        <ul class="mt-5 space-y-2.5">
          {responsibilities.map(item => (
            <li class="relative pl-6 text-[15px] leading-relaxed text-mono-subtle">
              <span class="absolute left-0 text-mono-muted" aria-hidden="true">
                —
              </span>
              {item}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>
