---
const year = new Date().getFullYear();

const links = [
  { label: 'Blog', href: '/blog' },
  { label: 'Infra', href: 'https://infra.msdqn.dev' },
  { label: 'GitHub', href: 'https://github.com/maulanasdqn' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/maulana-sodiqin/' },
];
---

<footer class="border-t border-mono-line">
  <div
    class="max-w-5xl mx-auto px-6 sm:px-8 py-10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6 text-sm"
  >
    <p class="text-mono-muted">&copy; {year} Maulana Sodiqin</p>
    <ul class="flex flex-wrap gap-x-6 gap-y-2" aria-label="Footer links">
      {
        links.map(link => (
          <li>
            <a
              href={link.href}
              class="text-mono-subtle hover:text-mono-text transition-colors"
              {...(link.href.startsWith('http')
                ? { target: '_blank', rel: 'noopener noreferrer' }
                : {})}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
