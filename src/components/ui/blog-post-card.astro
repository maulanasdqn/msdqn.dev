---
export interface Props {
  title: string;
  excerpt: string;
  slug: string;
  publishedAt: string;
  readTime: string;
  tags?: string[];
  featured?: boolean;
}

const {
  title,
  excerpt,
  slug,
  publishedAt,
  readTime,
  tags = [],
  featured = false,
} = Astro.props;

const formattedDate = new Date(publishedAt).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article
  class={`bg-rose-pine-surface/50 backdrop-blur-sm p-6 rounded-xl border transition-all duration-300 hover:bg-rose-pine-surface/70 ${featured ? 'border-rose-pine-love' : 'border-rose-pine-highlight-med'}`}
>
  {
    featured && (
      <div class="mb-3">
        <span class="bg-rose-pine-love text-white px-2 py-1 rounded-full text-xs font-medium">
          Featured
        </span>
      </div>
    )
  }

  <div class="mb-4">
    <div class="flex items-center gap-4 text-sm text-rose-pine-subtle mb-2">
      <time datetime={publishedAt}>
        {formattedDate}
      </time>
      <span>{readTime}</span>
    </div>

    <h2
      class="text-xl font-bold text-rose-pine-text mb-3 hover:text-rose-pine-foam transition-colors"
    >
      <a href={`/blog/${slug}`}>{title}</a>
    </h2>

    <p class="text-rose-pine-subtle leading-relaxed mb-4">
      {excerpt}
    </p>

    {
      tags.length > 0 && (
        <div class="flex flex-wrap gap-2">
          {tags.map(tag => (
            <span class="bg-rose-pine-highlight-low text-rose-pine-text px-3 py-1 rounded-full text-sm">
              {tag}
            </span>
          ))}
        </div>
      )
    }
  </div>

  <a
    href={`/blog/${slug}`}
    class="text-rose-pine-love hover:text-rose-pine-love/80 font-semibold text-sm inline-flex items-center gap-1 transition-colors"
  >
    Read More
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M9 5l7 7-7 7"></path>
    </svg>
  </a>
</article>
