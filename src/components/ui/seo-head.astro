---
import FontPreload from '@/components/ui/font-preload.astro';
import { OG_IMAGE, SITE_NAME, SITE_URL } from '@/libs/seo';

interface Props {
  title: string;
  description: string;
  path: string;
  type?: 'website' | 'profile';
  noindex?: boolean;
  jsonLd?: string;
}

const {
  title,
  description,
  path,
  type = 'website',
  noindex = false,
  jsonLd,
} = Astro.props;

const url = `${SITE_URL}${path}`;
---

<FontPreload />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content="Maulana Sodiqin" />
<meta
  name="robots"
  content={noindex
    ? 'noindex, follow'
    : 'index, follow, max-image-preview:large, max-snippet:-1'}
/>
<link rel="canonical" href={url} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/manifest.json" />
<meta name="theme-color" content="#0a0a0a" />
<meta name="color-scheme" content="dark" />

<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={type} />
<meta property="og:url" content={url} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content="en_US" />
<meta property="og:image" content={OG_IMAGE} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={OG_IMAGE} />
<meta name="twitter:image:alt" content={title} />

{jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
