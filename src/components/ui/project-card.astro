---
interface Props {
  title: string;
  description: string;
  technologies: string[];
  period?: string;
  category?: string;
  featured?: boolean;
  demoLink?: string;
  githubLink?: string;
}

const {
  title,
  description,
  technologies,
  period,
  category,
  featured = false,
  demoLink,
  githubLink,
} = Astro.props;

const meta = [category, featured ? 'Featured' : undefined].filter(Boolean);
---

<article
  class="grid grid-cols-1 md:grid-cols-12 gap-2 md:gap-8 py-10 border-b border-mono-line first:pt-0"
>
  <div class="md:col-span-3 text-xs text-mono-muted space-y-1 pt-1.5">
    {period && <p class="tabular-nums">{period}</p>}
    {
      meta.length > 0 && (
        <p class="uppercase tracking-wider">{meta.join(' · ')}</p>
      )
    }
  </div>
  <div class="md:col-span-9">
    <h3 class="font-medium text-2xl tracking-tight text-mono-text">{title}</h3>
    <p class="mt-4 text-mono-subtle leading-relaxed">{description}</p>
    {
      technologies.length > 0 && (
        <p class="mt-5 text-xs leading-relaxed text-mono-muted">
          {technologies.join(' / ')}
        </p>
      )
    }
    {
      (demoLink || githubLink) && (
        <div class="mt-6 flex gap-6 text-sm">
          {demoLink && (
            <a
              href={demoLink}
              target="_blank"
              rel="noopener noreferrer"
              class="text-mono-text underline decoration-mono-line-strong underline-offset-[6px] hover:decoration-mono-text transition-colors"
            >
              Visit <span aria-hidden="true">&nearr;</span>
            </a>
          )}
          {githubLink && (
            <a
              href={githubLink}
              target="_blank"
              rel="noopener noreferrer"
              class="text-mono-text underline decoration-mono-line-strong underline-offset-[6px] hover:decoration-mono-text transition-colors"
            >
              Source <span aria-hidden="true">&nearr;</span>
            </a>
          )}
        </div>
      )
    }
  </div>
</article>
