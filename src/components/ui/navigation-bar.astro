---
import '@fontsource-variable/onest';

const navItems = [
  { name: 'About', href: '/#about' },
  { name: 'Experience', href: '/#experience' },
  { name: 'Projects', href: '/#projects' },
  { name: 'Writing', href: '/blog' },
  { name: 'Infra', href: 'https://infra.msdqn.dev' },
  { name: 'Contact', href: '/#contact' },
];

const path = Astro.url.pathname;
---

<header
  class="fixed top-0 inset-x-0 z-50 bg-mono-bg/85 border-b border-mono-line"
>
  <nav
    class="max-w-5xl mx-auto px-6 sm:px-8 h-16 flex items-center justify-between"
    aria-label="Main navigation"
  >
    <a
      href="/"
      class="font-medium text-lg tracking-tight text-mono-text hover:text-mono-subtle transition-colors"
      aria-label="Maulana Sodiqin, home"
    >
      Maulana Sodiqin
    </a>

    <div class="hidden md:flex items-center gap-7">
      {
        navItems.map(item => (
          <a
            href={item.href}
            data-nav-link
            aria-current={
              path !== '/' && item.href === path ? 'page' : undefined
            }
            class="text-sm text-mono-subtle hover:text-mono-text transition-colors"
          >
            {item.name}
          </a>
        ))
      }
      <a
        href="/hire-me"
        aria-current={path === '/hire-me' ? 'page' : undefined}
        class="text-sm text-mono-text underline decoration-mono-line-strong underline-offset-[6px] hover:decoration-mono-text transition-colors"
      >
        Hire me
      </a>
    </div>

    <button
      id="mobile-menu-button"
      class="md:hidden -mr-2 p-2 text-mono-text"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Toggle menu"
    >
      <svg
        class="h-5 w-5"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path stroke-linecap="round" stroke-width="1.5" d="M4 8h16M4 16h16"
        ></path>
      </svg>
    </button>
  </nav>

  <div id="mobile-menu" class="md:hidden hidden border-t border-mono-line">
    <div class="max-w-5xl mx-auto px-6 py-4 flex flex-col">
      {
        navItems.map(item => (
          <a
            href={item.href}
            class="py-3 text-base text-mono-subtle hover:text-mono-text border-b border-mono-line transition-colors"
          >
            {item.name}
          </a>
        ))
      }
      <a
        href="/hire-me"
        class="pt-4 pb-1 text-base text-mono-text underline underline-offset-[6px]"
      >
        Hire me
      </a>
    </div>
  </div>
</header>

<style>
  header {
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  [data-nav-link][aria-current] {
    color: #fafafa;
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    const button = document.getElementById('mobile-menu-button');
    const menu = document.getElementById('mobile-menu');

    function setOpen(open) {
      menu.classList.toggle('hidden', !open);
      button.setAttribute('aria-expanded', open ? 'true' : 'false');
    }

    if (button && menu) {
      button.addEventListener('click', function () {
        setOpen(menu.classList.contains('hidden'));
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && !menu.classList.contains('hidden')) {
          setOpen(false);
          button.focus();
        }
      });
      menu.querySelectorAll('a').forEach(function (link) {
        link.addEventListener('click', function () {
          setOpen(false);
        });
      });
    }

    if (location.pathname !== '/' || !('IntersectionObserver' in window)) {
      return;
    }

    const links = document.querySelectorAll('[data-nav-link]');
    const observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          const hash = '/#' + entry.target.id;
          links.forEach(function (link) {
            const href = link.getAttribute('href');
            if (href === hash) {
              link.setAttribute('aria-current', 'true');
            } else if (href.startsWith('/#')) {
              link.removeAttribute('aria-current');
            }
          });
        });
      },
      { rootMargin: '-45% 0px -50% 0px' }
    );

    document.querySelectorAll('main section[id]').forEach(function (section) {
      observer.observe(section);
    });
  });
</script>
