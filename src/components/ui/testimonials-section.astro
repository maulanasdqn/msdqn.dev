---
import SectionHeading from './section-heading.astro';

interface Testimonial {
  id: number | string;
  name: string;
  role: string;
  company: string;
  content: string;
  rating: number;
}

interface Props {
  number: string;
  testimonials: Testimonial[];
}

const { number, testimonials } = Astro.props;
---

<section
  id="testimonials"
  class="max-w-5xl mx-auto px-6 sm:px-8 py-16 sm:py-20"
  aria-labelledby="testimonials-heading"
>
  <SectionHeading
    number={number}
    title="Kind Words"
    id="testimonials-heading"
  />
  <div class="grid grid-cols-1 md:grid-cols-2 gap-x-16 gap-y-14">
    {
      testimonials.map(testimonial => (
        <figure>
          <blockquote class="font-medium text-xl leading-relaxed text-mono-text">
            &ldquo;{testimonial.content}&rdquo;
          </blockquote>
          <figcaption class="mt-5 text-sm">
            <span class="text-mono-text">{testimonial.name}</span>
            <span class="text-mono-muted">
              {' '}
              &mdash; {testimonial.role}, {testimonial.company}
            </span>
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>
