---
interface Props {
  ctaText: string;
  ctaLink: string;
}

const { ctaText, ctaLink } = Astro.props;

const links = [
  { label: 'GitHub', href: 'https://github.com/maulanasdqn' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/maulana-sodiqin/' },
];
---

<div class="max-w-5xl mx-auto px-6 sm:px-8 pt-36 sm:pt-44 pb-24 sm:pb-32">
  <p
    class="text-xs font-medium uppercase tracking-[0.14em] text-mono-muted mb-10 rise"
  >
    Senior Software Engineer &mdash; Rust &amp; TypeScript
  </p>

  <h1
    class="font-medium text-[2.75rem] leading-[1.05] sm:text-6xl lg:text-7xl tracking-tight text-mono-text max-w-4xl rise"
    style="animation-delay: 80ms"
  >
    Building production web platforms in <em class="not-italic text-mono-subtle"
      >Rust</em
    > and
    <em class="not-italic text-mono-subtle">TypeScript</em>.
  </h1>

  <p
    class="mt-10 max-w-xl text-lg leading-relaxed text-mono-subtle rise"
    style="animation-delay: 160ms"
  >
    Seven years of shipping software. Sole engineer behind a rebuilt web
    scraping engine (400 jobs/s sustained, anti-bot unblocking), and I deliver
    full-stack client platforms end to end.
  </p>

  <div
    class="mt-12 flex flex-wrap items-center gap-x-8 gap-y-4 text-sm rise"
    style="animation-delay: 240ms"
  >
    <a
      href="/hire-me"
      class="inline-flex items-center gap-2 bg-mono-text text-mono-bg px-5 py-3 hover:bg-mono-subtle transition-colors"
    >
      Hire me <span aria-hidden="true">&rarr;</span>
    </a>
    <a
      href={ctaLink.startsWith('#') ? `/${ctaLink}` : ctaLink}
      class="text-mono-text underline decoration-mono-line-strong underline-offset-[6px] hover:decoration-mono-text transition-colors"
    >
      {ctaText}
    </a>
    <a
      href="https://blog.msdqn.dev"
      class="text-mono-text underline decoration-mono-line-strong underline-offset-[6px] hover:decoration-mono-text transition-colors"
    >
      Read the blog
    </a>
    {
      links.map(link => (
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          class="text-mono-subtle hover:text-mono-text transition-colors"
        >
          {link.label} <span aria-hidden="true">&nearr;</span>
        </a>
      ))
    }
  </div>
</div>

<style>
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .rise {
    animation: rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
</style>
