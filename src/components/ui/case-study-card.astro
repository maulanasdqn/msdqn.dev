---
export interface Props {
  title: string;
  client?: string;
  duration?: string;
  technologies?: string[];
  challenge?: string;
  solution?: string;
  results?: string[];
}

const { title, client, duration, technologies, challenge, solution, results } =
  Astro.props;

const meta = [client, duration].filter(Boolean);
---

<article
  class="grid grid-cols-1 md:grid-cols-12 gap-2 md:gap-8 py-10 border-b border-mono-line first:pt-0"
>
  <div class="md:col-span-3 text-xs text-mono-muted space-y-1 pt-1.5">
    {meta.map(item => <p>{item}</p>)}
  </div>
  <div class="md:col-span-9">
    <h3 class="font-medium text-2xl tracking-tight text-mono-text">{title}</h3>

    <dl class="mt-6 space-y-6">
      {
        challenge && (
          <div>
            <dt class="text-xs font-medium uppercase tracking-[0.14em] text-mono-muted mb-2">
              Challenge
            </dt>
            <dd class="text-mono-subtle leading-relaxed">{challenge}</dd>
          </div>
        )
      }
      {
        solution && (
          <div>
            <dt class="text-xs font-medium uppercase tracking-[0.14em] text-mono-muted mb-2">
              Solution
            </dt>
            <dd class="text-mono-subtle leading-relaxed">{solution}</dd>
          </div>
        )
      }
      {
        results && results.length > 0 && (
          <div>
            <dt class="text-xs font-medium uppercase tracking-[0.14em] text-mono-muted mb-2">
              Results
            </dt>
            <dd>
              <ul class="space-y-2">
                {results.map(result => (
                  <li class="relative pl-6 text-mono-subtle leading-relaxed">
                    <span
                      class="absolute left-0 text-mono-muted"
                      aria-hidden="true"
                    >
                      —
                    </span>
                    {result}
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        )
      }
    </dl>

    {
      technologies && technologies.length > 0 && (
        <p class="mt-6 text-xs leading-relaxed text-mono-muted">
          {technologies.join(' / ')}
        </p>
      )
    }
  </div>
</article>
