---
import AnimationWrapper from './animation-wrapper.astro';
---

<AnimationWrapper animation="scale-up" delay={100}>
  <form
    class="bg-mono-surface rounded-xl sm:rounded-2xl p-4 sm:p-6 lg:p-8 max-w-2xl mx-auto border border-mono-line"
  >
    <h2
      class="text-xl sm:text-2xl font-bold text-mono-text mb-4 sm:mb-6 text-center"
    >
      Get In Touch
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6 mb-4 sm:mb-6">
      <div>
        <label
          for="name"
          class="block text-sm font-medium text-mono-subtle mb-2"
        >
          Full Name
        </label>
        <input
          type="text"
          id="name"
          name="name"
          required
          class="w-full px-3 sm:px-4 py-2.5 sm:py-3 bg-mono-surface border border-mono-line rounded-lg sm:rounded-xl text-mono-text placeholder-mono-muted focus:ring-2 focus:ring-mono-accent focus:border-transparent transition-all text-sm sm:text-base"
          placeholder="Your full name"
        />
      </div>

      <div>
        <label
          for="email"
          class="block text-sm font-medium text-mono-subtle mb-2"
        >
          Email Address
        </label>
        <input
          type="email"
          id="email"
          name="email"
          required
          class="w-full px-3 sm:px-4 py-2.5 sm:py-3 bg-mono-surface border border-mono-line rounded-lg sm:rounded-xl text-mono-text placeholder-mono-muted focus:ring-2 focus:ring-mono-accent focus:border-transparent transition-all text-sm sm:text-base"
          placeholder="your.email@example.com"
        />
      </div>
    </div>

    <div class="mb-4 sm:mb-6">
      <label
        for="subject"
        class="block text-sm font-medium text-mono-subtle mb-2"
      >
        Subject
      </label>
      <input
        type="text"
        id="subject"
        name="subject"
        class="w-full px-3 sm:px-4 py-2.5 sm:py-3 bg-mono-surface border border-mono-line rounded-lg sm:rounded-xl text-mono-text placeholder-mono-muted focus:ring-2 focus:ring-mono-accent focus:border-transparent transition-all text-sm sm:text-base"
        placeholder="What's this about?"
      />
    </div>

    <div class="mb-4 sm:mb-6">
      <label
        for="message"
        class="block text-sm font-medium text-mono-subtle mb-2"
      >
        Message
      </label>
      <textarea
        id="message"
        name="message"
        rows="4"
        required
        class="w-full px-3 sm:px-4 py-2.5 sm:py-3 bg-mono-surface border border-mono-line rounded-lg sm:rounded-xl text-mono-text placeholder-mono-muted focus:ring-2 focus:ring-mono-accent focus:border-transparent transition-all resize-vertical text-sm sm:text-base"
        placeholder="Tell me about your project or opportunity..."></textarea>
    </div>

    <div class="text-center">
      <button
        type="submit"
        class="w-full sm:w-auto bg-mono-accent hover:bg-mono-subtle text-mono-bg px-6 sm:px-8 py-3 rounded-lg sm:rounded-xl font-semibold transition-all duration-300 inline-flex items-center justify-center gap-2 text-sm sm:text-base"
      >
        <svg
          class="w-4 h-4 sm:w-5 sm:h-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
        </svg>
        Send Message
      </button>
    </div>

    <p class="text-xs sm:text-sm text-mono-muted mt-3 sm:mt-4 text-center">
      I'll get back to you within 24 hours.
    </p>
  </form>
</AnimationWrapper>
